+/* WRITE(10) to device LBAs: final partition-boundary enforcement. */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || su.io_failed) {
+		return EROFS;
+	}
+	if (!su.nblocks || !count || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba > UINT32_MAX || count - 1 > UINT32_MAX - lba ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block)) {
+		printf("METROID UFS: rejected out-of-partition write lba=0x%llx blocks=%u\n",
+		    (unsigned long long)lba, count);
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16),
+		(uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
