+            memcpy((uint8_t *)v->cpu + b->address - v->iova,p,b->size);
+        }
+    }
+    for (size_t i = 0; i < l->count; i++)
+        l->publish(l->context,l->backing[i].cpu,l->backing[i].bytes);
