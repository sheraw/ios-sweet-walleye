+/* SPDX-License-Identifier: GPL-2.0-only
+ * Included ONLY at the end of metroid_touch_power.h by overlay 0033.
+ * Reuses its sole apps-DRV2 owner, lock, geometry and timeout quarantine.
+ * Temporary cold GPU diagnostic: retains highest command-DB CX/MX corners
+ * until reboot, so it cannot lower an unknown inherited shared rail vote.
+ * This is not runtime regulator aggregation or a DVFS policy.
+ */
+#ifndef METROID_GPU_RPMH_H
+#define METROID_GPU_RPMH_H
+int metroid_gpu_rpmh_enable(void);
+
+static int
+mg_arc_max(const char *name, uint32_t *address, uint32_t *level)
+{
+    uint32_t key[2] = {0, 0};
+    for (unsigned i = 0; i < 8 && name[i]; i++)
+        key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+    unsigned matches = 0;
+    for (unsigned i = 0; i < 8; i++) {
+        uint32_t h = 8 + 16 * i;
+        unsigned slave = rh_db16(h);
+        if (!slave) break;
+        uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+        uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+        unsigned count = rh_db16(h + 6);
+        if (slave < 3 || slave > 5 || (entries & 3) ||
+            !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0))
+            return EINVAL;
+        for (unsigned j = 0; j < count; j++) {
+            uint32_t e = entries + j * RH_DB_ENTRY;
+            if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1])
+                continue;
+            uint32_t a = rh_read(rh_db, e + 16);
+            uint32_t start = aux + rh_db16(e + 22);
+            unsigned bytes = rh_db16(e + 20);
+            if (slave != 3 || (a >> 16) != 3 || (a & 3) ||
+                !bytes || bytes > 32 || (bytes & 1) || (start & 1) ||
+                !rh_range(start, bytes)) return EINVAL;
+            unsigned last = 0, last_index = 0;
+            bool padding = false;
+            for (unsigned k = 0; k < bytes / 2; k++) {
+                unsigned value = rh_db16(start + k * 2);
+                if (!k) { if (value) return EINVAL; continue; }
+                if (!value) { padding = true; continue; }
+                if (padding || value <= last || value > 1024) return EINVAL;
+                last = value; last_index = k;
+            }
+            /* PLL calibration is 1305.6 MHz, requiring MX SVS_L1 (256).
+             * Also keep CX at least SVS_L1 for this deliberately high vote.
+             */
+            if (last < 256) return ENODEV;
+            *address = a; *level = last_index;
+            if (++matches != 1) return EINVAL;
+            printf("METROID GPU POWER: %s addr=%#x corner=%u index=%u retained until reboot\n",
+                name, a, last, last_index);
+        }
+    }
+    return matches == 1 ? 0 : ENODEV;
+}
+
+static int
+mg_arc_send(const uint32_t address[2], const uint32_t level[2])
+{
+    int chosen = -1;
+    for (unsigned t = RH_ACTIVE_FIRST; t < RH_ACTIVE_FIRST + RH_ACTIVE_N; t++) {
+        uint32_t b = t * RH_TCS_STRIDE;
+        uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+        if (enabled & ~((1u << rh_ncpt) - 1)) return EIO;
+        for (unsigned c = 0; c < rh_ncpt; c++) {
+            if (!(enabled & (1u << c))) continue;
+            uint32_t a = rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE);
+            if (a == address[0] || a == address[1]) return EBUSY;
+        }
+        if (chosen < 0 && rh_free(t)) chosen = (int)t;
+    }
+    if (chosen < 0) return EBUSY;
+    unsigned t = (unsigned)chosen;
+    uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+    uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+    if (irq_en == UINT32_MAX || !rh_free(t)) return EBUSY;
+    if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+        rh_poisoned = true; return EIO;
+    }
+    if (!rh_free(t)) {
+        if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit)))
+            rh_poisoned = true;
+        return EBUSY;
+    }
+    rh_poisoned = true;
+    for (unsigned c = 0; c < 2; c++) {
+        uint32_t cmd = b + c * RH_CMD_STRIDE;
