+/* SPDX-License-Identifier: GPL-2.0-only
+ * Cold CX/GMU clock bring-up from Nothing 031e8669eb19 gpucc-tuna.c,
+ * gcc-tuna.c, gdsc.c, clk-alpha-pll.c (Lucid OLE/EVO) and clk-rcg2.c.
+ * Requires a powered apps fabric/GCC XO. Deliberately refuses live handoff.
+ */
+#include "metroid_gpu.h"
+#define BIT(n) (1u << (n))
+
+static uint32_t rd(const struct mg_power_io *io, struct mg_power_status *s,
+    enum mg_bus bus, uint32_t offset)
+{
+    s->bus = bus; s->offset = offset;
+    s->value = io->read(io->context, bus, offset);
+    return s->value;
+}
+
+static int poll(const struct mg_power_io *io, struct mg_power_status *s,
+    enum mg_bus bus, uint32_t offset, uint32_t mask, uint32_t want)
+{
+    for (unsigned us = 0; us < 1000; us++) {
+        uint32_t v = rd(io, s, bus, offset);
+        if (v == UINT32_MAX) return MG_IO;
+        if ((v & mask) == want) return MG_OK;
+        io->delay(io->context, 1);
+    }
+    return MG_TIMEOUT;
+}
+
+static int change(const struct mg_power_io *io, struct mg_power_status *s,
+    enum mg_bus bus, uint32_t offset, uint32_t mask, uint32_t value)
+{
+    uint32_t old = rd(io, s, bus, offset);
+    if (old == UINT32_MAX) return MG_IO;
+    s->touched = true;
+    io->write(io->context, bus, offset, (old & ~mask) | value);
+    return poll(io, s, bus, offset, mask, value);
+}
+
+static int branch(const struct mg_power_io *io, struct mg_power_status *s,
+    enum mg_bus bus, uint32_t offset, bool skip_halt)
+{
+    int r = change(io, s, bus, offset, BIT(0), BIT(0));
+    if (r) return r;
+    /* GCC DDRSS_GPU_AXI is BRANCH_HALT_SKIP. AHB uses HALT_DELAY. */
+    if (skip_halt) { io->delay(io->context, 10); return MG_OK; }
+    return poll(io, s, bus, offset, BIT(31), 0);
+}
+
+static int rcg(const struct mg_power_io *io, struct mg_power_status *s,
+    uint32_t offset, unsigned parent, unsigned hid)
+{
+    int r = change(io, s, MG_CC, offset + 4,
+        0x1fu | (7u << 8) | (3u << 12) | BIT(20),
+        hid | (parent << 8) | BIT(20));
+    if (r) return r;
+    uint32_t old = rd(io, s, MG_CC, offset);
+    if (old == UINT32_MAX) return MG_IO;
+    io->write(io->context, MG_CC, offset, old | BIT(0));
+    return poll(io, s, MG_CC, offset, BIT(0), 0);
+}
+
+int mg_power_enable(const struct mg_power_io *io, struct mg_power_status *s)
+{
+    if (!s) return MG_INVALID;
+    *s = (struct mg_power_status){0};
+    if (!io || !io->read || !io->write || !io->delay || !io->rails)
+        return MG_INVALID;
+    /* No live GPU/PLL takeover: changing a parent underneath running firmware
+     * or taking its reset would destroy unknown command/buffer ownership.
+     */
+    const uint32_t idle[] = {0x90d4, 0x9060, 0x90e8, 0x93e8};
+    for (unsigned i = 0; i < sizeof(idle)/sizeof(idle[0]); i++) {
+        uint32_t v = rd(io, s, MG_CC, idle[i]);
+        if (v == UINT32_MAX) return MG_IO;
+        if (v & BIT(0)) return MG_BUSY;
+    }
+    uint32_t v = rd(io, s, MG_CC, 0x9080);
+    if (v == UINT32_MAX) return MG_IO;
+    if (v & (BIT(31) | BIT(1) | BIT(2))) return MG_BUSY;
+    v = rd(io, s, MG_CC, 0);
+    if (v == UINT32_MAX) return MG_IO;
+    if (v & BIT(0)) return MG_BUSY;
+    v = rd(io, s, MG_CC, 4);
+    if (v == UINT32_MAX) return MG_IO;
+    if (v != 0) return MG_BUSY;
+    v = rd(io, s, MG_CC, 0x18);
+    if (v == UINT32_MAX) return MG_IO;
+    if (v & BIT(25)) return MG_UNSUPPORTED; /* FSM vote mode */
+    /* Check the shared GPLL0 source before the first vote/register write. */
+    v = rd(io, s, MG_GCC, 0);
+    if (v == UINT32_MAX) return MG_IO;
+    if (!(v & BIT(31))) return MG_UNSUPPORTED;
+    v = rd(io, s, MG_GCC, 0x10);
+    if (v == UINT32_MAX) return MG_IO;
+    if ((v & 0xffffu) != 31u) return MG_UNSUPPORTED;
+    v = rd(io, s, MG_GCC, 0x14);
+    if (v == UINT32_MAX) return MG_IO;
+    if ((v & 0xffffu) != 0x4000u) return MG_UNSUPPORTED;
+    /* The callback may have sent a vote even when its ACK times out. */
+    s->touched = true;
+    if (io->rails(io->context)) return MG_IO;
+    s->stage = MG_POWER_RAILS;
+#define TRY(expr) do { int error = (expr); if (error) return error; } while (0)
+    /* Hold GMU's clock-controller reset before enabling any GMU clock. */
+    TRY(change(io, s, MG_CC, 0x9314, BIT(0), BIT(0)));
+    /* GDSC wait fields 2/2/8 and retention follow gpu_cc_cx_gdsc. */
+    TRY(change(io, s, MG_CC, 0x9080,
+        0xfff000u | BIT(11) | 7u, 0x228000u | BIT(11)));
+    io->delay(io->context, 1);
+    TRY(poll(io, s, MG_CC, 0x9094, BIT(31), BIT(31)));
+    io->delay(io->context, 1);
+    s->stage = MG_POWER_CX;
+    /* Probe's always-on branches. Keep reset asserted throughout this test. */
+    const uint32_t aon[] = {0x93a4, 0x9008, 0x93a8, 0x9004, 0x90cc};
+    for (unsigned i = 0; i < sizeof(aon)/sizeof(aon[0]); i++)
+        TRY(branch(io, s, MG_CC, aon[i], false));
+    /* Standby PLL: 1 GHz main / 2 = 500 MHz GMU. Calibration runs at
+     * 0x44 * 19.2 MHz; rails callback must cover that rate, not just GMU.
+     * No active PLL reprogramming or dynamic frequency changes.
+     */
+    TRY(change(io, s, MG_CC, 0, BIT(2), 0));
+    static const struct { uint32_t off, val; } pll[] = {
+        {0x10, 0x44440034}, {0x14, 0x1555},
+        {0x20, 0x20485699}, {0x24, 0x00182261}, {0x28, 0x82aa299c},
+        {0x18, 0x00000407}, {0x1c, 0x00000005},
+        {0x2c, 0}, {0x30, 3}, {0x34, 0x9000}, {0x38, 0x34},
+    };
+    for (unsigned i = 0; i < sizeof(pll)/sizeof(pll[0]); i++)
+        TRY(change(io, s, MG_CC, pll[i].off, UINT32_MAX, pll[i].val));
+    TRY(change(io, s, MG_CC, 0, BIT(2), BIT(2)));
+    TRY(change(io, s, MG_CC, 4, UINT32_MAX, 1));
+    TRY(poll(io, s, MG_CC, 0, BIT(31), BIT(31)));
+    /* Calibration completion is required before publishing PLL output. */
+    TRY(poll(io, s, MG_CC, 0, BIT(8), 0));
+    TRY(change(io, s, MG_CC, 0, BIT(0), BIT(0)));
+    s->stage = MG_POWER_PLL;
+    /* GPLL0 at 600 MHz feeds HUB /3. Verify its source rather than retuning
+     * a shared PLL used by unrelated peripherals. L=31, alpha=0x4000.
+     */
+    TRY(branch(io, s, MG_GCC, 0x71150, false));
+    TRY(rcg(io, s, 0x93ec, 5, 5)); /* 600 / ((5+1)/2) = 200 */
+    TRY(rcg(io, s, 0x9318, 2, 1)); /* PLL0 even /1 = 500 */
+    s->stage = MG_POWER_HUB;
+    TRY(branch(io, s, MG_GCC, 0x71158, true));
+    TRY(branch(io, s, MG_GCC, 0x71010, false));
+    TRY(branch(io, s, MG_CC, 0x93e8, false));
+    TRY(branch(io, s, MG_CC, 0x90e8, false));
+    TRY(branch(io, s, MG_CC, 0x90bc, true));
+    TRY(branch(io, s, MG_CC, 0x90e4, false));
+    TRY(branch(io, s, MG_CC, 0x90d4, false));
+    s->stage = MG_POWER_CLOCKS;
+    TRY(poll(io, s, MG_CC, 0x9314, BIT(0), BIT(0)));
+    s->stage = MG_POWER_RESET_HELD;
+    return MG_OK;
+#undef TRY
+}
