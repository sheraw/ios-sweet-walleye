+/* SPDX-License-Identifier: GPL-2.0-only
+ * Metroid Adreno825 hardware bring-up entry point. metroidgpu=1 reads ONLY
+ * the GPU clock-controller registers below. metroidgpu=2 attempts a cold
+ * CX/clock test, retaining high CX/MX votes and holding GMU reset until reboot.
+ * Default off; no GMU execution, SMMU changes or accelerator service.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <pexpert/arm64/boot.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "metroid_gpu.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+void metroid_gpu_init(void);
+static unsigned mg_started;
+
+struct mg_hardware { vm_offset_t cc, gcc; };
+static uint32_t mg_read(void *context, enum mg_bus bus, uint32_t offset)
+{
+    struct mg_hardware *h = context;
+    uint32_t value = *(volatile uint32_t *)((bus == MG_CC ? h->cc : h->gcc) + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+static void mg_write(void *context, enum mg_bus bus, uint32_t offset, uint32_t value)
+{
+    struct mg_hardware *h = context;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)((bus == MG_CC ? h->cc : h->gcc) + offset) = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static void mg_delay(void *context, unsigned us) { (void)context; delay((int)us); }
+static int mg_rails(void *context) { (void)context; return metroid_gpu_rpmh_enable(); }
+
+static bool mg_is_metroid(void)
+{
+    DTEntry root;
+    const void *value;
+    unsigned size = 0;
+    if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+        SecureDTGetProperty(root, "compatible", &value, &size) != kSuccess)
+        return false;
+    const char *list = value;
+    /* DT properties are bounded byte arrays, not necessarily C strings. */
+    for (unsigned offset = 0; offset < size;) {
+        size_t length = strnlen(list + offset, size - offset);
+        if (length == size - offset) return false;
+        if (length == sizeof("nothing,metroid") - 1 &&
+            memcmp(list + offset, "nothing,metroid", length) == 0) return true;
+        offset += (unsigned)length + 1;
+    }
+    return false;
+}
+
+static void mg_payload_check(void)
+{
+    DTEntry node;
+    const void *property;
+    unsigned size = 0;
+    static struct mg_fw_plan plan;
+    if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+        SecureDTGetProperty(node, "MetroidGMU", &property, &size) != kSuccess || size != 16) {
+        printf("METROID GPU: no reserved MetroidGMU image; use metroid-gpu-payload.py\n");
+        return;
+    }
+    uint64_t extent[2];
+    memcpy(extent, property, sizeof(extent));
+    const boot_args *args = PE_state.bootArgs;
+    uint64_t pa = extent[0], bytes = extent[1];
+    if (!args || args->Version != 2 || !bytes || bytes > MG_FW_MAX_BYTES ||
+        (pa & PAGE_MASK) || pa < args->physBase ||
+        args->topOfKernelData < args->physBase ||
+        args->topOfKernelData - args->physBase > args->memSize ||
+        pa > args->topOfKernelData || bytes > args->topOfKernelData - pa) {
+        printf("METROID GPU: invalid reserved GMU firmware extent\n");
+        return;
+    }
+    const void *image = (const void *)ml_static_ptovirt((vm_offset_t)pa);
+    int result = mg_fw_parse(image, (size_t)bytes, &plan);
+    printf("METROID GPU: reserved GMU preflight result=%d bytes=%llu blocks=%u reservations=%u\n",
+        result, (unsigned long long)bytes, plan.count, plan.reservation_count);
+    printf("METROID GPU: firmware preflight only; no power writes, SMMU changes or firmware execution\n");
+}
+
+void metroid_gpu_init(void)
+{
+    int mode = 0;
+    if (!PE_parse_boot_argn("metroidgpu", &mode, sizeof(mode)) || !mode) return;
+    if ((mode != 1 && mode != 2 && mode != 3) || !mg_is_metroid()) {
+        printf("METROID GPU: unsupported mode/platform; disabled\n");
+        return;
+    }
+    /* IOKit can retry service startup. Never repeat a partial hardware test. */
+    if (__atomic_exchange_n(&mg_started, 1, __ATOMIC_ACQUIRE)) return;
+    if (mode == 3) { mg_payload_check(); return; }
+    /* Each offset is from Nothing's drivers/clk/qcom/gpucc-tuna.c.
+     * Do not probe GX, CM3, TCM or SMMU registers before power/clock bring-up:
+     * reads of a powered-down domain can themselves produce a bus fault.
+     */
+    static const struct { const char *name; uint32_t offset; } registers[] = {
+        {"CX_GDSCR", 0x9080}, {"CX_GDS_HW_CTRL", 0x9094},
+        {"AHB_CBCR", 0x90bc}, {"CX_GMU_CBCR", 0x90d4},
+        {"CXO_CBCR", 0x90e4}, {"HUB_CX_CBCR", 0x90e8},
+        {"SMMU_VOTE", 0x7000},
+    };
+    uint32_t snapshot[sizeof(registers) / sizeof(registers[0])];
+    /* ml_io_map's PA argument need not be page aligned: preserve its returned
+     * byte bias by mapping the containing 16K pages explicitly.
+     */
+    uint64_t base = MG_GPUCC_PA & ~(uint64_t)PAGE_MASK;
+    vm_size_t bias = (vm_size_t)(MG_GPUCC_PA - base);
+    vm_size_t span = (vm_size_t)round_page(bias + MG_GPUCC_SIZE);
+    vm_offset_t mapping = ml_io_map((vm_offset_t)base, span);
+    if (!mapping) {
+        printf("METROID GPU: GPUCC mapping failed\n");
+        return;
+    }
+    for (unsigned i = 0; i < sizeof(registers) / sizeof(registers[0]); i++) {
+        __asm__ volatile("dmb oshld" ::: "memory");
+        snapshot[i] = *(volatile uint32_t *)(mapping + bias + registers[i].offset);
+    }
+    __asm__ volatile("dmb oshld" ::: "memory");
+    printf("METROID GPU: target Adreno825 Gen8.6.0 chip=%#x (source profile, not hardware ID)\n", MG_CHIP_ID);
+    for (unsigned i = 0; i < sizeof(registers) / sizeof(registers[0]); i++)
+        printf("METROID GPU: GPUCC %s +%#x = %#x\n",
+            registers[i].name, registers[i].offset, snapshot[i]);
+    if (mode == 2) {
+        /* GCC is shared with other devices. Only the three GPU branch enables
+         * are written; shared GPLL0 is read/verified and never reprogrammed.
+         */
+        vm_size_t gcc_size = 0x80000;
+        vm_offset_t gcc = ml_io_map(0x00100000, gcc_size);
+        if (gcc) {
+            struct mg_hardware hardware = {mapping + bias, gcc};
+            struct mg_power_io io = {&hardware, mg_read, mg_write, mg_delay, mg_rails};
+            struct mg_power_status status;
+            int result = mg_power_enable(&io, &status);
+            printf("METROID GPU: power-test result=%d stage=%u touched=%u bus=%u offset=%#x value=%#x\n",
+                result, status.stage, status.touched, status.bus, status.offset, status.value);
+            if (!result)
+                printf("METROID GPU: CX/clocks acknowledged; GMU held in reset; reboot ends test\n");
+            else if (status.touched)
+                printf("METROID GPU: incomplete power test; no retry/rollback; reboot required\n");
+            ml_io_unmap(gcc, gcc_size);
+        } else printf("METROID GPU: GCC mapping failed; power test not attempted\n");
+    }
+    ml_io_unmap(mapping, span);
+    printf("METROID GPU: GMU firmware/SMMU/submission not started; acceleration unavailable\n");
+}
+#endif
