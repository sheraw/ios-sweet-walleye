+        const struct mg_fw_reservation *r = &plan->reservations[i];
+        if (r->region != MG_ITCM && r->region != MG_DTCM && !find(l,r->address,r->size))
+            return MG_UNBACKED;
+    }
+    for (unsigned i = 0; i < plan->count; i++) {
+        const struct mg_fw_block *b = &plan->blocks[i];
+        if (b->region != MG_ITCM && b->region != MG_DTCM && !find(l,b->address,b->size))
+            return MG_UNBACKED;
+    }
+    for (size_t i = 0; i < l->count; i++) memset(l->backing[i].cpu,0,l->backing[i].bytes);
+    for (unsigned i = 0; i < plan->count; i++) {
+        const struct mg_fw_block *b = &plan->blocks[i];
+        const uint8_t *p = (const uint8_t *)image + b->offset;
+        if (b->region == MG_ITCM || b->region == MG_DTCM) {
+            uint32_t start = b->region == MG_ITCM ? 0x1b400 : 0x1c400;
+            uint32_t base = b->region == MG_ITCM ? 0 : 0x10004000;
+            for (unsigned j = 0; j < b->size; j += 4) {
+                uint32_t word = (uint32_t)p[j] | (uint32_t)p[j+1] << 8 |
+                    (uint32_t)p[j+2] << 16 | (uint32_t)p[j+3] << 24;
+                l->tcm_write(l->context,start + (b->address - base + j)/4,word);
+            }
