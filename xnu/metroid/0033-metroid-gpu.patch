+    WRITE(0x1f82d, 0x4052);
+    WRITE(0x3c03, 0x71e20); WRITE(0x3c04, 0x71e20);
+    WRITE(0x3c05, 0x71e20); WRITE(0x3c06, 0x71e20);
+    WRITE(0x3c00, 0x20023000); WRITE(0x3c45, BIT(3));
+    WRITE(0x1f9cb, c->vrb); WRITE(0x1f9c9, 0);
+    WRITE(0x1f9ca, 0x08060000); /* ADRENO_GMU_REV(8,6,0), not DT chip ID */
+    WRITE(0x1f9c8, c->log | (c->log_bytes / 4096 - 1));
+    WRITE(0x1f40f, 1); WRITE(0x1f400, 1); WRITE(0x1f401, 1);
+    uint32_t bcl = rd(io, s, 0x1fc40);
+    if (bcl == UINT32_MAX) { ret = MG_IO; goto fail; }
+    WRITE(0x1fc40, (bcl & 255) | 0x19171300);
+    /* Polling milestone: mask GMU2HOST IRQs; no uninstalled IRQ handler. */
+    /* All ones is the legitimate interrupt mask value, so do not use the
+     * generic inaccessible-register sentinel check for this register. */
+    io->write(io->context, 0x1f993, UINT32_MAX);
+    if (rd(io,s,0x1f993) != UINT32_MAX) { ret = MG_IO; goto fail; }
+    io->write(io->context, 0x1f991, UINT32_MAX);
+    io->write(io->context, 0x23b06, UINT32_MAX); /* AO mask: 1 masks */
+    if (rd(io,s,0x23b06) != UINT32_MAX) { ret = MG_IO; goto fail; }
+    io->write(io->context, 0x23b04, UINT32_MAX); /* AO pending W1C */
+    WRITE(0x27833, 0); /* CX_MISC mask: 1 enables */
+    io->write(io->context, 0x27831, UINT32_MAX);
+    WRITE(0x1f986, 0);
+    if (rd(io, s, HFI_STATUS) != 0) { ret = MG_STALE; goto fail; }
+    /* Offline format compatibility is insufficient: check loaded DTCM. */
+    if (rd(io, s, 0x1c400 + 0xff8) != 0x50040001 ||
+        rd(io, s, 0x1c400 + 0xffc) != 0x20070001) {
+        ret = MG_UNSUPPORTED; goto fail;
+    }
+    s->stage = MG_START_CONFIG;
+    io->write(io->context, RESET, 0);
+    s->released = true;
+    ret = poll(io,s,RESULT,0x1ff,0x100); if (ret) goto fail;
+    s->stage = MG_START_CM3;
+    io->write(io->context, 0x1f986, 1);
+    ret = poll(io,s,HFI_STATUS,1,1); if (ret) goto fail;
+    s->stage = MG_START_HFI;
+    return MG_OK;
+fail:
+    io->write(io->context, RESET, 1);
+    s->quarantined = true;
+    return ret;
+#undef WRITE
+}
