+        !l->count || l->count > MG_DMA_MAX_RANGES || !image || !plan ||
+        bytes > UINTPTR_MAX - (uintptr_t)image ||
+        alias((uintptr_t)plan,sizeof(*plan),(uintptr_t)image,bytes) ||
+        alias((uintptr_t)plan,sizeof(*plan),(uintptr_t)l,sizeof(*l)) ||
+        alias((uintptr_t)plan,sizeof(*plan),(uintptr_t)l->backing,l->count * sizeof(*l->backing)))
+        return MG_INVALID;
