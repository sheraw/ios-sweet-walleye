+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef METROID_GPU_START_H
+#define METROID_GPU_START_H
+#include "metroid_gpu.h"
+
+/* Cold GMU stream-5 domain, independent of the apps SMMU. All operations
+ * require exclusive ownership, CM3 held in reset and pinned memory until reboot.
+ * No global reset or inherited bypass/translation takeover is permitted.
+ * MMIO offsets here are BYTES relative to MG_SMMU_PA.
+ */
+struct mg_smmu_io {
+    void *context;
+    uint32_t (*read)(void *, uint32_t);
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*write64)(void *, uint32_t, uint64_t);
+    void (*delay)(void *, unsigned);
+    /* Clean immutable tables to PoC and complete a device-visible barrier. */
+    void (*publish)(void *, const void *, size_t);
+};
+#define MG_PT_MAX_PAGES 64u
+#define MG_DMA_MAX_RANGES 64u
+struct mg_dma_range { uint32_t iova, bytes; uint64_t pa; bool executable; };
+struct mg_page_tables {
+    void *memory; uint64_t pa; size_t bytes;
+    unsigned used;
+    bool built;
+};
+struct mg_smmu_domain {
+    uint32_t page_shift, gr1, cb_base, cb, smr, asid, ips;
+    bool attempted, touched, attached, quarantined;
+    uint32_t offset, value;
+};
+/* 4K SMMU granules, 32-bit IOVA, 3-level tables. CPU pages may be 16K.
+ * The caller supplies contiguous, aligned, private table storage and ranges
+ * backed by pinned RAM. No table/data aliasing or physical data aliases.
+ * Failure clears built; a failed/attached pool must not be rebuilt or freed.
+ */
+int mg_smmu_tables(struct mg_page_tables *, const struct mg_dma_range *, size_t);
+int mg_smmu_attach(const struct mg_smmu_io *, struct mg_smmu_domain *,
+    const struct mg_page_tables *);
+
+struct mg_gmu_backing { uint32_t iova, bytes; void *cpu; };
+struct mg_gmu_loader {
+    void *context;
+    void (*tcm_write)(void *, uint32_t, uint32_t); /* GPU-relative DWORD */
+    void (*publish)(void *, const void *, size_t); /* clean to PoC + barrier */
+    const struct mg_gmu_backing *backing;
+    size_t count;
+};
+/* Caller owns reset and immutable firmware. Every external reservation must
+ * have private, page-aligned backing already mapped in stream 5. Validate all
+ * backing before any writes, zero external backing, load TCM/cache, publish.
+ * This is the concrete sink for mg_start_io.prepare; no firmware authentication.
+ */
+int mg_gmu_load(const void *, size_t, struct mg_fw_plan *, const struct mg_gmu_loader *);
+
+/* Secure CX register initialization is distinct from ZAP/PAS authentication
+ * for later secure GPU execution. These functions do not authenticate GMU.
+ * SCM callback follows ARM SMCCC: a0 transport status, a1 service result.
+ * The platform must serialize SCM with other clients and preserve x6 on
+ * interrupted-call resume. No retry is made after busy/WAITQ/error responses.
+ */
+struct mg_scm_result { int64_t status; uint64_t value; };
+typedef struct mg_scm_result (*mg_scm_call)(void *, uint32_t, uint32_t, uint64_t);
+int mg_secure_cx_init(mg_scm_call, void *, struct mg_scm_result *);
+/* ARM64 production transport; serializes GPU SCM calls, bounded interrupted
+ * resumes with the QCOM x6 quirk. No WAITQ integration: nonzero status fails. */
+struct mg_scm_result mg_scm_native(void *, uint32_t, uint32_t, uint64_t);
+
+enum mg_start_stage { MG_START_OFF, MG_START_RESET, MG_START_MEMORY,
+    MG_START_SECURE, MG_START_CONFIG, MG_START_CM3, MG_START_HFI };
+struct mg_start_status {
+    enum mg_start_stage stage;
+    uint32_t reg, value;
+    struct mg_scm_result scm;
+    bool attempted, released, quarantined;
+};
+/* Register callbacks take GPU-relative DWORD indices (gen8_reg.h), including
+ * CX_MISC registers beyond MG_GMU_SIZE. The caller maps the actual apertures.
+ * ready() must verify pinned stream-5 mappings, retained DDR/CNOC/TCU votes,
+ * powered/clocks-on CX/SMMU and exclusive cold ownership. prepare() implements
+ * AHB timeout + CX timer setup, TCM/external loading and coherent HFI/log/VRB
+ * initialization, all while CM3 is reset. Neither may release reset.
+ * The GMU clock-controller reset must already have been deasserted safely.
+ */
+struct mg_start_io {
+    void *context;
+    uint32_t (*read)(void *, uint32_t);
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*delay)(void *, unsigned);
+    int (*ready)(void *);
+    int (*prepare)(void *);
+    mg_scm_call scm;
+};
+struct mg_start_config { uint32_t hfi, log, log_bytes, vrb; };
+/* Boot to HFI_CTRL_STATUS only. This is NOT the scheduler START protocol.
+ * Fresh zero-initialized status is consumed once, even on failure. On any
+ * failure after reset ownership, reassert CM3 reset and quarantine resources;
+ * reset is not proof that DMA has drained. Never free/reuse mappings on error.
+ */
+int mg_gmu_start(const struct mg_start_io *, const struct mg_start_config *,
+    struct mg_start_status *);
+#endif
