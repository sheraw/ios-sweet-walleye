@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2021, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2023-2024, Qualcomm Innovation Center, Inc. All rights reserved.
+ *
+ * GMU block firmware loader, adapted from the public Gen8 memory layout and
+ * kgsl_gmu_core.h block ABI. No Apple or Qualcomm firmware is embedded here.
+ */
+#include "metroid_gpu.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#else
+#include <libkern/libkern.h>
+#endif
+
+static uint32_t mg_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+        (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static int mg_region_for(uint32_t address, uint32_t size)
+{
+    static const uint32_t starts[] = {0, 0x4000, 0x10004000, 0x60000000, 0xc0000000};
+    static const uint32_t lengths[] = {0x4000, 0xffc000, 0x4000, 0x20000000, 0x20000000};
+    uint64_t end = (uint64_t)address + size;
+    if (!size || (address & 3) || (size & 3)) return MG_INVALID;
+    for (unsigned i = 0; i < sizeof(starts) / sizeof(starts[0]); i++)
+        if (address >= starts[i] && end <= (uint64_t)starts[i] + lengths[i])
+            return (int)i;
+    return MG_UNSUPPORTED;
+}
+
+static bool mg_overlap(uint32_t a, uint32_t n, uint32_t b, uint32_t m)
+{
+    return (uint64_t)a < (uint64_t)b + m && (uint64_t)b < (uint64_t)a + n;
+}
+
+static int mg_parse(const uint8_t *image, size_t bytes, struct mg_fw_plan *p)
+{
+    size_t offset = 0;
+    bool data_seen = false;
+    if (!image || !bytes || bytes > MG_FW_MAX_BYTES) return MG_INVALID;
+    while (offset < bytes) {
+        if (bytes - offset < 16) return MG_INVALID;
+        uint32_t address = mg_le32(image + offset), size = mg_le32(image + offset + 4);
+        uint32_t type = mg_le32(image + offset + 8), value = mg_le32(image + offset + 12);
+        offset += 16;
+        if (size > bytes - offset) return MG_INVALID;
+        if (size) {
+            /* Stock Metroid GMU payload records use DE AD BE EF bytes in
+             * both unused header words. KGSL ignores these words whenever
+             * size != 0; accept that observed encoding plus zero headers,
+             * without interpreting the marker as a metadata type.
+             */
+            if (type != 0 && !(type == 0xefbeaddeu && value == 0xefbeaddeu))
+                return MG_UNSUPPORTED;
+            int region = mg_region_for(address, size);
+            if (region < 0) return region;
+            if (p->count == MG_FW_MAX_BLOCKS) return MG_LIMIT;
+            for (uint32_t i = 0; i < p->count; i++)
+                if (mg_overlap(address, size, p->blocks[i].address, p->blocks[i].size))
+                    return MG_INVALID;
+            p->blocks[p->count++] = (struct mg_fw_block){address, size, (uint32_t)offset, (uint32_t)region};
+            data_seen = true;
+        } else {
+            /* Nothing's parser requires metadata to precede load data. */
+            if (data_seen) return MG_INVALID;
+            if (type == 1 || type == 7) {
+                int region = mg_region_for(address, value);
+                if (region < 0) return region;
+                if (p->reservation_count == MG_FW_MAX_RESERVATIONS) return MG_LIMIT;
+                for (uint32_t i = 0; i < p->reservation_count; i++) {
+                    const struct mg_fw_reservation *r = &p->reservations[i];
+                    if (mg_overlap(address, value, r->address, r->size)) return MG_INVALID;
+                }
+                p->reservations[p->reservation_count++] = (struct mg_fw_reservation){
+                    address, value, type == 7, (uint32_t)region};
+            } else if (type >= 2 && type <= 6) {
+                if (p->metadata_mask & (1u << (type - 2))) return MG_INVALID;
+                p->metadata_mask |= 1u << (type - 2);
+                p->versions[type - 2] = value;
+            } else if (type != 0) return MG_UNSUPPORTED;
+        }
+        offset += size;
+    }
+    if (!p->count) return MG_INVALID;
+    /* Match load_fw's requirement that non-TCM data has backing reserved first.
+     * Allocation granules/permissions are the SMMU allocator's responsibility.
+     */
+    for (uint32_t i = 0; i < p->count; i++) {
+        const struct mg_fw_block *b = &p->blocks[i];
+        if (b->region == MG_ITCM || b->region == MG_DTCM) continue;
+        bool backed = false;
+        for (uint32_t j = 0; j < p->reservation_count; j++) {
+            const struct mg_fw_reservation *r = &p->reservations[j];
+            if (b->address >= r->address &&
+                (uint64_t)b->address + b->size <= (uint64_t)r->address + r->size)
+                backed = true;
+        }
+        if (!backed) return MG_UNBACKED;
+    }
+    return MG_OK;
+}
+
+int mg_fw_parse(const void *image, size_t bytes, struct mg_fw_plan *plan)
+{
+    if (!plan) return MG_INVALID;
+    memset(plan, 0, sizeof(*plan));
+    int result = mg_parse(image, bytes, plan);
+    if (result) memset(plan, 0, sizeof(*plan));
+    return result;
+}
+
+int mg_fw_load(const void *image, size_t bytes, struct mg_fw_plan *plan,
+    const struct mg_fw_sink *sink)
+{
+    if (!sink || !sink->prepare || !sink->write) return MG_INVALID;
+    int result = mg_fw_parse(image, bytes, plan);
+    if (result) return result;
+    for (uint32_t i = 0; i < plan->count; i++)
+        if (!sink->prepare(sink->context, &plan->blocks[i])) return MG_UNBACKED;
+    for (uint32_t i = 0; i < plan->count; i++) {
+        const struct mg_fw_block *b = &plan->blocks[i];
+        if (!sink->write(sink->context, b, (const uint8_t *)image + b->offset)) return MG_IO;
+    }
+    return MG_OK;
+}
--- /dev/null
+++ b/bsd/dev/metroid_gpu_hfi.c
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2020-2021, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022-2024, Qualcomm Innovation Center, Inc. All rights reserved.
+ *
+ * Gen8 HFI host transport. Matches adreno_hfi.h/adreno_gen8_hfi.c wire layout.
+ * No live GMU is started by this file. See the memory/locking contract in .h.
+ */
+#include "metroid_gpu.h"
+#ifdef MG_HOST_TEST
+#include <string.h>
+#define MG_MB() __atomic_thread_fence(__ATOMIC_SEQ_CST)
+#else
+#include <libkern/libkern.h>
+#define MG_MB() __asm__ volatile("dmb osh" ::: "memory")
+#endif
+
+_Static_assert(sizeof(struct mg_hfi_header) == 48, "HFI queue ABI");
+_Static_assert(offsetof(struct mg_hfi_header, read) == 40, "HFI read ABI");
+_Static_assert(offsetof(struct mg_hfi_header, write) == 44, "HFI write ABI");
+_Static_assert(sizeof(struct mg_hfi_table) == 840, "HFI table ABI");
+
+static uint32_t mg_queue_type(unsigned queue)
+{
+    /* Gen8.6.0 selects the hwsched backend: all three control queues have
+     * priority 0 (adreno_gen8_hwsched_hfi.c), unlike the legacy 10/10/40.
+     */
+    return queue;
+}
+
+static bool mg_memory_valid(void *memory, size_t bytes, uint32_t address)
+{
+    uint64_t end = (uint64_t)address + MG_HFI_BYTES;
+    return memory && !((uintptr_t)memory & 15) && bytes >= MG_HFI_BYTES && !(address & 15) &&
+        ((address >= 0x60000000 && end <= 0x80000000ull) ||
+         (address >= 0xc0000000 && end <= 0xe0000000ull));
+}
+
+int mg_hfi_init(void *memory, size_t bytes, uint32_t address)
+{
+    if (!mg_memory_valid(memory, bytes, address)) return MG_INVALID;
+    memset(memory, 0, MG_HFI_BYTES);
+    struct mg_hfi_table *t = memory;
+    t->size = sizeof(*t) / 4;
+    t->header_offset = 6;
+    t->header_size = 12;
+    t->count = t->active = MG_HFI_QUEUES;
+    for (unsigned i = 0; i < MG_HFI_QUEUES; i++) {
+        struct mg_hfi_header *h = &t->queue[i];
+        h->status = 1;
+        h->address = address + (uint32_t)MG_HFI_OFFSET + i * MG_HFI_WORDS * 4;
+        h->type = mg_queue_type(i);
+        h->words = MG_HFI_WORDS;
+    }
+    MG_MB();
+    return MG_OK;
+}
+
+int mg_hfi_bind(void *memory, size_t bytes, uint32_t address,
+    unsigned queue, struct mg_hfi_queue *out)
+{
+    if (!out || queue >= MG_HFI_QUEUES || !mg_memory_valid(memory, bytes, address))
+        return MG_INVALID;
+    volatile struct mg_hfi_table *t = memory;
+    if (t->version || t->size != sizeof(*t) / 4 || t->header_offset != 6 ||
+        t->header_size != 12 || t->count != MG_HFI_QUEUES || t->active != MG_HFI_QUEUES)
+        return MG_INVALID;
+    *out = (struct mg_hfi_queue){
+        .header = &t->queue[queue],
+        .ring = (volatile uint32_t *)((uint8_t *)memory + MG_HFI_OFFSET) + queue * MG_HFI_WORDS,
+        .address = address + (uint32_t)MG_HFI_OFFSET + queue * MG_HFI_WORDS * 4,
+        .type = mg_queue_type(queue),
+    };
+    return MG_OK;
+}
+
+int mg_hfi_message(uint32_t id, uint32_t type, uint32_t sequence,
+    uint32_t words, uint32_t *out)
+{
+    if (!out || id > 255 || type > 1 || sequence > 4095 ||
+        !words || words > MG_HFI_MAX_MESSAGE) return MG_INVALID;
+    *out = id | words << 8 | type << 16 | sequence << 20;
+    return MG_OK;
+}
+
+static int mg_queue_indices(struct mg_hfi_queue *q, uint32_t *read, uint32_t *write)
+{
+    if (!q || !q->header || !q->ring) return MG_INVALID;
+    volatile struct mg_hfi_header *h = q->header;
+    if (h->status != 1 || h->address != q->address || h->type != q->type ||
+        h->words != MG_HFI_WORDS || h->message_size) return MG_INVALID;
+    *read = h->read;
+    *write = h->write;
+    MG_MB();
+    if (*read >= MG_HFI_WORDS || *write >= MG_HFI_WORDS || ((*read | *write) & 3))
+        return MG_INVALID;
+    return MG_OK;
+}
+
+int mg_hfi_write(struct mg_hfi_queue *q, const uint32_t *message, size_t words)
+{
+    uint32_t read, write;
+    if (!message || !words || words > MG_HFI_MAX_MESSAGE ||
+        ((message[0] >> 8) & 255) != words) return MG_INVALID;
+    int result = mg_queue_indices(q, &read, &write);
+    if (result) return result;
+    uint32_t padded = ((uint32_t)words + 3) & ~3u;
+    uint32_t used = (write + MG_HFI_WORDS - read) % MG_HFI_WORDS;
+    if (MG_HFI_WORDS - used <= padded) return MG_FULL;
+    for (uint32_t i = 0; i < padded; i++)
+        q->ring[(write + i) % MG_HFI_WORDS] = i < words ? message[i] : 0xfafafafa;
+    MG_MB();
+    q->header->write = (write + padded) % MG_HFI_WORDS;
+    MG_MB(); /* publish before caller rings the GMU doorbell */
+    return MG_OK;
+}
+
+int mg_hfi_read(struct mg_hfi_queue *q, uint32_t *out, size_t capacity)
+{
+    uint32_t read, write;
+    if (!out || !capacity) return MG_INVALID;
+    int result = mg_queue_indices(q, &read, &write);
+    if (result) return result;
+    if (read == write) return MG_EMPTY;
+    uint32_t words = (q->ring[read] >> 8) & 255;
+    uint32_t padded = (words + 3) & ~3u;
+    uint32_t used = (write + MG_HFI_WORDS - read) % MG_HFI_WORDS;
+    if (!words || used < padded) return MG_INVALID;
+    if (words > capacity) return MG_TOO_SMALL;
+    for (uint32_t i = 0; i < words; i++) out[i] = q->ring[(read + i) % MG_HFI_WORDS];
+    MG_MB(); /* consume the payload before returning its space to the GMU */
+    q->header->read = (read + padded) % MG_HFI_WORDS;
+    MG_MB();
+    return (int)words;
+}
+
+int mg_hfi_ack(const uint32_t *message, size_t words, uint32_t sent, uint32_t *result)
+{
+    if (!message || !result || words < 3 || words > MG_HFI_MAX_MESSAGE ||
+        ((message[0] >> 8) & 255) != words || ((message[0] >> 16) & 15) != 1)
+        return MG_INVALID;
+    /* Full echoed header, including original size and sequence; ignore RECORD
+     * exactly as Nothing's CMP_HFI_ACK_HDR does. Never mutate the input headers.
+     */
+    if ((message[1] & ~(1u << 19)) != (sent & ~(1u << 19))) return MG_STALE;
+    *result = message[2];
+    return MG_OK;
+}
