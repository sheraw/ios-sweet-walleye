+static bool alias(uintptr_t a, size_t n, uintptr_t b, size_t m)
+{ return a < b + m && b < a + n; }
+int mg_gmu_load(const void *image, size_t bytes, struct mg_fw_plan *plan,
+    const struct mg_gmu_loader *l)
+{
