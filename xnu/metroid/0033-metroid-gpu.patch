+static const struct mg_gmu_backing *find(const struct mg_gmu_loader *l,
+    uint32_t address, uint32_t size)
+{
+    for (size_t i = 0; i < l->count; i++) {
+        const struct mg_gmu_backing *b = &l->backing[i];
+        if (address >= b->iova && (uint64_t)address + size <= (uint64_t)b->iova + b->bytes)
+            return b;
+    }
+    return NULL;
+}
+static bool external(uint32_t a, uint32_t n)
+{
+    uint64_t end = (uint64_t)a + n;
+    return (a >= 0x4000 && end <= 0x1000000) ||
+        (a >= 0x60000000 && end <= 0x80000000) ||
+        (a >= 0xc0000000 && end <= 0xe0000000);
