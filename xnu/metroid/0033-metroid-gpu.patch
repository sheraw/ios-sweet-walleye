+    for (size_t i = 0; i < l->count; i++) {
+        const struct mg_gmu_backing *b = &l->backing[i];
+        if (!b->cpu || !b->bytes || ((b->iova | b->bytes | (uintptr_t)b->cpu) & 4095) ||
+            !external(b->iova,b->bytes) || b->bytes > UINTPTR_MAX - (uintptr_t)b->cpu ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)image,bytes) ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)plan,sizeof(*plan)) ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)l,sizeof(*l)) ||
+            alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)l->backing,l->count * sizeof(*l->backing)))
+            return MG_INVALID;
+        for (size_t j = 0; j < i; j++) {
+            const struct mg_gmu_backing *p = &l->backing[j];
+            if (alias(b->iova,b->bytes,p->iova,p->bytes) ||
+                alias((uintptr_t)b->cpu,b->bytes,(uintptr_t)p->cpu,p->bytes)) return MG_INVALID;
