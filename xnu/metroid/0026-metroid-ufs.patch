+#define MU_TIMEOUT_US 5000000u
+#define MU_DEVICE_WLUN 0xd0u
+#define MU_DEVICE_ACTIVE_TIMEOUT_US 10000000u /* Nothing START STOP: 10 * HZ */
+#define MU_QUERY_ATTEMPTS 3u /* Nothing ufshcd.c QUERY_REQ_RETRIES */
+#define MU_UIC_DONE (1u << 10)
+#define MU_HIBERN8_EXIT_DONE (1u << 5)
+#define MU_TX_FSM_ATTRIBUTE (0x41u << 16) /* QCOM MPHY_TX_FSM_STATE, lane 0 */
+#define MU_TX_FSM_HIBERN8 1u
+#define MU_QCOM_CFG1 0xdcu
+#define MU_QCOM_HW_VERSION 0xe4u
+#define MU_QCOM_REF_CLK (1u << 26)
+#define MU_QCOM_NO_ICE_CHECK (1u << 31)
+/* Nothing arm-smmu.h ARM_SMMU_FSR_FAULT: MULTI, SS and bits 8:1.
+ * Bit 10 (0x400) is not a recognized context fault. Do not infer a valid
+ * fault address from FAR unless an actual fault bit is set.
+ */
+#define MU_SMMU_FSR_FAULT 0xc00001feu
+#define MU_FATAL_IS ((1u << 2) | (1u << 7) | (1u << 11) | (1u << 16) | (1u << 17) | (1u << 18))
