+	uint64_t pool_pa, tables_pa;
+	uint64_t *tables;
+	uint32_t pgshift, cb_base, gr1, ncb, ns2cb, nsmr, cb, smr, asid, ips;
+	uint32_t old_smr, old_s2cr;
+	uint32_t tx_fsm;
+	const char *phase;
+	uint32_t core_mhz, unipro_mhz, phy_gear, uic_result, link_errors[5];
+	uint16_t device_spec, manufacturer;
+	uint32_t target_gear;
+	uint64_t commands, read_bytes, write_bytes, service_us, max_us, sleeps;
+	uint64_t scsi_calls, slow_calls, lock_wait_us, lock_max_us;
+	struct mu_io_stats io[MU_IO_KINDS];
+	enum mu_state state;
+	bool mapped, failed, configured, poll_only, stats;
+};
+
+static void mu_fail(struct mu_host *h) { h->failed = true; h->state = MU_IO_FAILED; }
+
+static uint32_t mu_r(struct mu_host *h, uint32_t off) { return MU_READ32(h->regs + off); }
+static void mu_w(struct mu_host *h, uint32_t off, uint32_t v) { MU_WRITE32(h->regs + off, v); MU_BARRIER(); }
+static uint32_t mu_sr(struct mu_host *h, uint32_t off) { return MU_READ32(h->smmu + off); }
+static void mu_sw(struct mu_host *h, uint32_t off, uint32_t v) { MU_WRITE32(h->smmu + off, v); MU_BARRIER(); }
+static uint32_t mu_cb(struct mu_host *h, uint32_t cb) { return h->cb_base + (cb << h->pgshift); }
+static uint64_t mu_sr64(struct mu_host *h, uint32_t off) { return (uint64_t)mu_sr(h, off) | (uint64_t)mu_sr(h, off + 4) << 32; }
+/* Aligned 64-bit device accesses, as used for AArch64 TTBRs in Linux. */
+static void mu_sw64(struct mu_host *h, uint32_t off, uint64_t v) { MU_WRITE64(h->smmu + off, v); MU_BARRIER(); }
+
+static int
+mu_poll(struct mu_host *h, bool smmu, uint32_t off, uint32_t mask,
+    uint32_t want, uint32_t timeout)
+{
+	uint64_t start = MU_NOW_US();
+	do {
+		uint32_t v = smmu ? mu_sr(h, off) : mu_r(h, off);
+		if ((v & mask) == want) { return 0; }
+		MU_DELAY(10);
+	} while (MU_NOW_US() - start < timeout);
+	return ETIMEDOUT;
+}
+
+static void
+mu_dump(struct mu_host *h, const char *stage)
+{
+	MU_LOG("METROID UFS[%s]: IS=%08x HCS=%08x HCE=%08x DBR=%08x RSR=%08x MEMCFG=%08x UTRL=%08x:%08x\n",
+	    stage, mu_r(h, 0x20), mu_r(h, 0x30), mu_r(h, 0x34), mu_r(h, 0x58),
+	    mu_r(h, 0x60), mu_r(h, 0x300), mu_r(h, 0x54), mu_r(h, 0x50));
+	MU_LOG("METROID UFS[%s]: phase=%s AHIT=%08x QCOM_VER=%08x CFG1=%08x TX_FSM=%x\n",
+	    stage, h->phase ? h->phase : "idle", mu_r(h, 0x18),
+	    mu_r(h, MU_QCOM_HW_VERSION), mu_r(h, MU_QCOM_CFG1), h->tx_fsm);
+	if (h->mapped && h->pool) {
+		/* Descriptors were cleaned before submission; no CPU writes occur
+		 * while DMA owns them. Refresh cache lines for diagnostic reads only.
+		 * OCS=invalid with DBR=1 alone does not prove the request was unfetched.
+		 */
+		MU_FLUSH((uintptr_t)h->pool, sizeof(struct mu_utrd));
+		MU_FLUSH((uintptr_t)h->pool + MU_UCD + offsetof(struct mu_ucd, response), 32);
+		MU_BARRIER();
+		const volatile struct mu_utrd *d = (const volatile struct mu_utrd *)h->pool;
+		const volatile struct mu_ucd *c = (const volatile struct mu_ucd *)(h->pool + MU_UCD);
+		MU_LOG("METROID UFS[%s]: request=%02x cdb=%02x tag=%02x UTRD_OCS=%08x header=%08x UCD=%08x:%08x\n",
+		    stage, c->request[0], c->request[16], c->request[3], d->ocs, d->header, d->ucd_hi, d->ucd_lo);
+		MU_LOG("METROID UFS[%s]: response=%02x flags=%02x lun=%02x tag=%02x result=%02x status=%02x resp_off=%u resp_len=%u prdt_len=%u\n",
+		    stage, c->response[0], c->response[1], c->response[2], c->response[3], c->response[6], c->response[7],
+		    d->response_offset, d->response_len, d->prdt_len);
+	}
+	MU_LOG("METROID SMMU[%s]: sCR0=%08x sACR=%08x GFSR=%08x GFSYNR1=%08x\n",
+	    stage, mu_sr(h, 0), mu_sr(h, 0x10), mu_sr(h, 0x48), mu_sr(h, 0x54));
+	MU_LOG("METROID UFS[%s]: UECPA=%08x UECDL=%08x UECN=%08x UECT=%08x UECDME=%08x\n",
+	    stage, mu_r(h, 0x38), mu_r(h, 0x3c), mu_r(h, 0x40), mu_r(h, 0x44), mu_r(h, 0x48));
+	if (h->configured) {
+		uint32_t b = mu_cb(h, h->cb);
+		MU_LOG("METROID SMMU[%s]: SID=60 SMR[%u]=%08x S2CR=%08x CB=%u SCTLR=%08x FSR=%08x FAR=%08x:%08x FSYNR0=%08x\n",
+		    stage, h->smr, mu_sr(h, 0x800 + 4 * h->smr), mu_sr(h, 0xc00 + 4 * h->smr),
+		    h->cb, mu_sr(h, b), mu_sr(h, b + 0x58), mu_sr(h, b + 0x64), mu_sr(h, b + 0x60), mu_sr(h, b + 0x68));
+		MU_LOG("METROID SMMU[%s]: fault_bits=%08x fault_SID=%04x (FAR meaningful only with fault_bits)\n",
+		    stage, mu_sr(h, b + 0x58) & MU_SMMU_FSR_FAULT,
+		    mu_sr(h, h->gr1 + 0x400 + 4 * h->cb) & 0xffff);
+		MU_LOG("METROID SMMU[%s]: CBAR=%08x CBA2R=%08x TCR=%08x TCR2=%08x TTBR0=%08x:%08x MAIR=%08x:%08x\n",
+		    stage, mu_sr(h, h->gr1 + 4 * h->cb), mu_sr(h, h->gr1 + 0x800 + 4 * h->cb),
+		    mu_sr(h, b + 0x30), mu_sr(h, b + 0x10), mu_sr(h, b + 0x24), mu_sr(h, b + 0x20),
+		    mu_sr(h, b + 0x3c), mu_sr(h, b + 0x38));
+	}
+}
+
+/* Stop both legacy engines before replacing any descriptor or DMA mappings.
+ * An already-selected MCQ controller requires a separate queue teardown and
+ * is refused before writes, not switched to legacy behind firmware's back. */
+static int
+mu_quiesce(struct mu_host *h)
+{
+	if (mu_r(h, 8) < 0x00000200) { return ENOTSUP; }
+	if ((mu_r(h, 0) & (1u << 29)) || (mu_r(h, 0x300) & 1)) {
+		MU_LOG("METROID UFS: MCQ active or legacy removed; MCQ teardown is not implemented\n");
+		return ENOTSUP;
+	}
+	if (!(mu_r(h, 0x34) & 1) && !h->phy) {
+		MU_LOG("METROID UFS: firmware PHY/host is off; cold PHY/clock bring-up required\n");
+		return ENXIO;
+	}
+	if (mu_r(h, 0x58) || mu_r(h, 0x78)) { return EBUSY; }
+	/* Freeze automatic link sleep before changing the DMA domain. Existing
+	 * manual Hibern8 is handled explicitly before enabling request lists. */
+	mu_w(h, 0x18, 0);
+	if (mu_r(h, 0x18) & 0x1fff) {
+		MU_LOG("METROID UFS: cannot disable automatic Hibern8\n");
+		return EIO;
+	}
+	mu_w(h, 0x24, 0);
+	mu_w(h, 0x60, 0);
+	mu_w(h, 0x80, 0);
+	if (mu_poll(h, false, 0x60, 1, 0, 10000) || mu_poll(h, false, 0x80, 1, 0, 10000)) { return ETIMEDOUT; }
+	if (mu_r(h, 0x58) || mu_r(h, 0x78)) { return EBUSY; }
+	return 0;
+}
diff --git a/bsd/dev/metroid_ufs_device.h b/bsd/dev/metroid_ufs_device.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/metroid_ufs_device.h
@@ -0,0 +1,108 @@
+/* UFS device management: standard query UPIUs (Nothing ufshcd query helpers).
+ * Query results are always checked, including GENERAL_FAILURE. This deliberately
+ * does not copy the reference completion helper's nonzero-result success bug.
+ */
+static uint32_t mu_upiu_word(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+static void mu_query_dump(const char *which, const uint8_t *p)
+{
+	MU_LOG("METROID UFS: query-%s %08x %08x %08x %08x %08x %08x %08x %08x\n", which,
+	    mu_upiu_word(p), mu_upiu_word(p + 4), mu_upiu_word(p + 8), mu_upiu_word(p + 12),
+	    mu_upiu_word(p + 16), mu_upiu_word(p + 20), mu_upiu_word(p + 24), mu_upiu_word(p + 28));
+}
+static int
+mu_query(struct mu_host *h, uint8_t opcode, uint8_t idn, uint16_t allocation, uint16_t *received)
+{
+	if (h->failed || allocation > 255) { return EIO; }
+	for (unsigned attempt = 1; attempt <= 3; attempt++) {
+		int error = mu_prepare(h, 0x16, 0);
+		if (error) { return error; }
+		struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+		c->request[5] = opcode == 6 ? 0x81 : 1;
+		c->request[12] = opcode; c->request[13] = idn;
+		c->request[18] = (uint8_t)(allocation >> 8); c->request[19] = (uint8_t)allocation;
+		error = mu_submit(h, 0, false, 0x36);
+		if (error) { return error; }
+		uint8_t result = c->response[6];
+		uint16_t segment = (uint16_t)((uint32_t)c->response[10] << 8 | c->response[11]);
+		uint16_t length = (uint16_t)((uint32_t)c->response[18] << 8 | c->response[19]);
+		if (!result && !c->response[7] && c->response[5] == c->request[5] && !memcmp(c->request + 12, c->response + 12, 4) &&
+		    ((!allocation && !segment && !length) ||
+		    (allocation && length <= allocation && segment == length))) {
+			if (received) { *received = length; }
+			return 0;
+		}
+		MU_LOG("METROID UFS: %s attempt=%u/3 opcode=%02x result=%02x status=%02x\n",
+		    h->phase, attempt, opcode, result, c->response[7]);
+		mu_query_dump("req", c->request); mu_query_dump("rsp", c->response);
+		if (result != 0xff || c->response[7] || attempt == 3) { return EIO; }
+		MU_DELAY(1000);
+	}
+	return EIO;
+}
+static int
+mu_query_flag(struct mu_host *h, bool set, uint8_t *value)
+{
+	h->phase = set ? "fDeviceInit-set" : "fDeviceInit-read";
+	int error = mu_query(h, set ? 6 : 5, 1, 0, NULL);
+	if (!error) { *value = ((struct mu_ucd *)(h->pool + MU_UCD))->response[23] & 1; }
+	return error;
+}
+static int
+mu_wait_device_init(struct mu_host *h)
+{
+	uint64_t start = MU_NOW_US();
+	do {
+		uint8_t flag = 1;
+		int error = mu_query_flag(h, false, &flag);
+		if (error || !flag) { return error; }
+		MU_DELAY(1000);
+	} while (MU_NOW_US() - start < MU_TIMEOUT_US);
+	return ETIMEDOUT;
+}
+static int
+mu_device_descriptor(struct mu_host *h)
+{
+	h->phase = "device-descriptor";
+	uint16_t length = 0;
+	int error = mu_query(h, 1, 0, 255, &length); /* READ_DESC, device IDN0 */
+	if (error) { return error; }
+	const uint8_t *d = ((struct mu_ucd *)(h->pool + MU_UCD))->response + 32;
+	if (length < 0x1a || d[0] < 0x1a || d[0] > length || d[1] != 0) { return EIO; }
+	h->device_spec = (uint16_t)((uint32_t)d[0x10] << 8 | d[0x11]);
+	h->manufacturer = (uint16_t)((uint32_t)d[0x18] << 8 | d[0x19]);
+	if (h->device_spec < 0x0200 || h->device_spec > 0x0400) { return ENOTSUP; }
+	MU_LOG("METROID UFS: device spec=%04x manufacturer=%04x LUs=%u\n", h->device_spec, h->manufacturer, d[6]);
+	return 0;
+}
+static int
+mu_activate_device(struct mu_host *h)
+{
+	const uint8_t active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	for (unsigned attempt = 1; attempt <= 3; attempt++) {
+		int error = mu_scsi(h, MU_DEVICE_WLUN, active, sizeof(active), 0, false);
+		MU_LOG("METROID UFS: device ACTIVE attempt=%u/3 errno=%d\n", attempt, error);
+		if (!error || h->failed || error != EAGAIN || attempt == 3) { return error; }
+		MU_DELAY(10000);
+	}
+	return EIO;
+}
+static int
+mu_device_init(struct mu_host *h)
+{
+	if (h->failed || h->state != MU_LINK_READY) { return EIO; }
+	h->phase = "nop";
+	int error = mu_prepare(h, 0, 0);
+	if (!error) { error = mu_submit(h, 0, false, 0x20); }
+	if (error) { return error; }
+	uint8_t flag = 1;
+	error = mu_query_flag(h, true, &flag);
+	if (!error) { error = mu_wait_device_init(h); }
+	if (!error) { error = mu_device_descriptor(h); }
+	if (!error) { error = mu_activate_device(h); }
+	if (!error && h->target_gear) { error = mu_hs_mode(h, h->target_gear); }
+	if (!error) { h->state = MU_DEVICE_READY; }
+	return error;
+}
diff --git a/bsd/dev/metroid_ufs_hci.h b/bsd/dev/metroid_ufs_hci.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/metroid_ufs_hci.h
@@ -0,0 +1,177 @@
+/* Serialized legacy UTP queue with explicit DMA/cache ownership.
+ * v4 supports this transport when CAP.LSDBRemoved=0; MCQ is not required. */
+/* No timeout retries: a late DMA must never land in a reused command buffer. */
+static int
+mu_submit(struct mu_host *h, uint32_t len, bool write, uint8_t response_type)
+{
+	if (len > MU_BOUNCE) { return EINVAL; }
+	if (!h->mapped || h->state < MU_LINK_READY || h->failed || mu_r(h, 0x58) || !(mu_r(h, 0x60) & 1)) { return EIO; }
+	uint64_t service_start = MU_NOW_US();
+	struct mu_utrd *d = (struct mu_utrd *)h->pool;
+	struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+	/* Detect a lost/changed stream or list base before publishing a request. */
+	if (mu_sr(h, 0x800 + 4 * h->smr) != ((1u << 31) | MU_SID) ||
+	    (mu_sr(h, 0xc00 + 4 * h->smr) & ((3u << 16) | 0xff)) != h->cb ||
+	    !(mu_sr(h, mu_cb(h, h->cb)) & 1) ||
+	    mu_r(h, 0x50) != MU_IOVA || mu_r(h, 0x54)) {
+		mu_fail(h); mu_dump(h, "dma-route-changed"); return EIO;
+	}
+	d->header = (1u << 28) | (1u << 24) | (len ? (write ? 1u : 2u) << 25 : 0);
+	d->ocs = 0xf;
+	d->ucd_lo = (uint32_t)(MU_IOVA + MU_UCD); d->ucd_hi = 0;
+	d->response_len = 512 / 4; d->response_offset = 512 / 4;
+	d->prdt_len = (uint16_t)((len + 0x3ffff) / 0x40000); d->prdt_offset = 1024 / 4;
+	for (uint32_t i = 0, done = 0; i < d->prdt_len; i++) {
+		uint32_t chunk = len - done > 0x40000 ? 0x40000 : len - done;
+		c->prdt[i].lo = (uint32_t)(MU_IOVA + MU_DATA + done);
+		c->prdt[i].hi = 0; c->prdt[i].bytes = chunk - 1;
+		done += chunk;
+	}
+	/* Transfer cache ownership, including previously cached response/OCS
+	 * lines, before doorbell. CPU never writes these while DMA owns them. */
+	MU_FLUSH((uintptr_t)d, sizeof(*d));
+	MU_FLUSH((uintptr_t)c, sizeof(*c));
+	if (len) {
+		if (write) { MU_CLEAN((uintptr_t)h->pool + MU_DATA, len); }
+		else { MU_FLUSH((uintptr_t)h->pool + MU_DATA, len); }
+	}
+	MU_BARRIER();
+	mu_w(h, 0x58, 1);
+	/* Device power transitions have Linux's separate ten-second deadline. */
+	uint32_t timeout = response_type == 0x21 && c->request[2] == MU_DEVICE_WLUN &&
+	    c->request[16] == 0x1b ? MU_DEVICE_ACTIVE_TIMEOUT_US : MU_TIMEOUT_US;
+	uint64_t start = MU_NOW_US();
+	while (mu_r(h, 0x58) & 1) {
+		uint32_t is = mu_r(h, 0x20);
+		uint32_t fault = mu_sr(h, mu_cb(h, h->cb) + 0x58) & MU_SMMU_FSR_FAULT;
+		uint64_t elapsed = MU_NOW_US() - start;
+		if ((is & MU_FATAL_IS) || fault || elapsed >= timeout) {
+			mu_fail(h);
+			mu_dump(h, "timeout/fault");
+			return ((is & MU_FATAL_IS) || fault) ? EIO : ETIMEDOUT;
+		}
+		/* Fast completions stay on-CPU for 50us. Long transfers release
+		 * this CPU with 200us..1ms polling backoff. Slot ownership
+		 * and the original command deadline survive every sleep. */
+		uint32_t pause = timeout - (uint32_t)elapsed;
+		uint32_t interval = elapsed < 1000 ? 200 : elapsed < 5000 ? 500 : 1000;
+		if (pause > interval) { pause = interval; }
+		if (elapsed >= 50 && !h->poll_only && MU_WAIT_US(pause)) { h->sleeps++; }
+		else { MU_DELAY(elapsed < 50 ? 1 : (pause < 10 ? pause : 10)); }
+	}
+	MU_BARRIER();
+	MU_FLUSH((uintptr_t)d, sizeof(*d));
+	MU_FLUSH((uintptr_t)c->response, sizeof(c->response));
+	if (len && !write) { MU_FLUSH((uintptr_t)h->pool + MU_DATA, len); }
+	if ((mu_r(h, 0x20) & MU_FATAL_IS) ||
+	    (mu_sr(h, mu_cb(h, h->cb) + 0x58) & MU_SMMU_FSR_FAULT)) {
+		mu_fail(h); mu_dump(h, "completion-fault"); return EIO;
+	}
+	mu_w(h, 0x20, 1); /* acknowledge transfer completion only */
+	if ((d->ocs & 0xff) || c->response[8] || c->response[0] != response_type ||
+	    c->response[2] != c->request[2] || c->response[3] != c->request[3]) {
+		MU_LOG("METROID UFS: malformed completion OCS=%x response=%x tag=%x/%x\n",
+		    d->ocs, c->response[0], c->response[3], c->request[3]);
+		mu_fail(h); return EIO;
+	}
+	h->commands++;
+	if (write) { h->write_bytes += len; } else { h->read_bytes += len; }
+	uint64_t service = MU_NOW_US() - service_start;
+	h->service_us += service;
+	if (service > h->max_us) { h->max_us = service; }
+
+	return 0;
+}
+
+static int
+mu_prepare(struct mu_host *h, uint8_t type, uint8_t lun)
+{
+	if (!h->mapped || h->failed || h->state < MU_LINK_READY) { return EIO; }
+	if (mu_r(h, 0x58)) { mu_fail(h); return EBUSY; }
+	memset(h->pool, 0, sizeof(struct mu_utrd));
+	struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+	memset(c, 0, sizeof(*c));
+	c->request[0] = type; c->request[2] = lun; c->request[3] = 0; /* slot 0 */
+	return 0;
+}
+
+static int
+mu_scsi_exec(struct mu_host *h, uint8_t lun, const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	if (h->failed) { return EIO; }
+	if (!cdb || cdb_len > 16 || !cdb_len || len > MU_BOUNCE) { return EINVAL; }
+	h->phase = lun == MU_DEVICE_WLUN && cdb[0] == 0x1b ? "device-active" : "scsi";
+	int error = mu_prepare(h, 1, lun);
+	if (error) { return error; }
+	struct mu_ucd *c = (struct mu_ucd *)(h->pool + MU_UCD);
+	c->request[1] = len ? (write ? 0x20 : 0x40) : 0;
+	c->request[12] = (uint8_t)(len >> 24); c->request[13] = (uint8_t)(len >> 16);
+	c->request[14] = (uint8_t)(len >> 8); c->request[15] = (uint8_t)len;
+	memcpy(c->request + 16, cdb, cdb_len);
+	error = mu_submit(h, len, write, 0x21);
+	if (error) { return error; }
+	if (c->response[6] || c->response[7]) {
+		const uint8_t *sense = c->response + 34;
+		uint32_t sense_len = (uint32_t)c->response[32] << 8 | c->response[33];
+		uint32_t data_len = (uint32_t)c->response[10] << 8 | c->response[11];
+		uint8_t key = 0xff, asc = 0, ascq = 0;
+		if (sense_len >= 14 && sense_len <= 18 && data_len >= sense_len + 2 &&
+		    ((sense[0] & 0x7f) == 0x70 || (sense[0] & 0x7f) == 0x71)) {
+			key = sense[2] & 0xf; asc = sense[12]; ascq = sense[13];
+		} else if (sense_len >= 4 && sense_len <= 18 && data_len >= sense_len + 2 &&
+		    ((sense[0] & 0x7f) == 0x72 || (sense[0] & 0x7f) == 0x73)) {
+			key = sense[1] & 0xf; asc = sense[2]; ascq = sense[3];
+		}
+		MU_LOG("METROID UFS: SCSI cmd=%02x LUN=%02x response=%02x status=%02x sense=%02x/%02x/%02x\n",
+		    cdb[0], lun, c->response[6], c->response[7], key, asc, ascq);
+		/* Retry completed sense conditions, never a transport failure.
+		 * Some devices report target failure (response=1) with the reset
+		 * UNIT ATTENTION after our reset. Consume that notification with
+		 * a bounded retry; it is not successful device activation. */
+		bool reset_attention = c->response[6] == 1 && key == 6 && asc == 0x29 && ascq == 2;
+		return c->response[7] == 2 &&
+		    ((!c->response[6] && (key == 6 || key == 2)) || reset_attention) ? EAGAIN : EIO;
+	}
+	/* Refuse short/overflowed reads; stale bounce bytes must not reach BSD. */
+	if (c->response[1] & 0x60) { return EIO; }
+	return 0;
+}
+
+/* Record SCSI outcomes after status/residual validation, separately from
+ * transport completions. Slow writes and zero-byte syncs must be distinguishable. */
+static int
+mu_scsi(struct mu_host *h, uint8_t lun, const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	uint64_t start = MU_NOW_US();
+	int error = mu_scsi_exec(h, lun, cdb, cdb_len, len, write);
+	uint8_t op = cdb && cdb_len ? cdb[0] : 0xff;
+	unsigned kind = op == 0x88 ? MU_IO_READ : op == 0x8a ? MU_IO_WRITE :
+	    op == 0x91 ? MU_IO_SYNC : MU_IO_OTHER;
+	struct mu_io_stats *io = &h->io[kind];
+	uint64_t us = MU_NOW_US() - start;
+	io->calls++; io->errors += error != 0; io->us += us;
+	if (!error) { io->bytes += len; }
+	if (us > io->max_us) { io->max_us = us; }
+	h->scsi_calls++;
+	if (h->stats && us >= 100000) {
+		h->slow_calls++;
+		/* Bound framebuffer logging even when every request is slow. */
+		if (h->slow_calls <= 4 || !(h->slow_calls & (h->slow_calls - 1))) {
+			MU_LOG("METROID UFS slow: cdb=%02x bytes=%u us=%llu error=%d slow-count=%llu\n",
+			    op, len, (unsigned long long)us, error, (unsigned long long)h->slow_calls);
+		}
+	}
+	if (h->stats && !(h->scsi_calls % 1024)) {
+		MU_LOG("METROID UFS stats: lock-wait-us=%llu lock-max-us=%llu sleeps=%llu\n",
+		    (unsigned long long)h->lock_wait_us, (unsigned long long)h->lock_max_us,
+		    (unsigned long long)h->sleeps);
+		for (unsigned i = 0; i < MU_IO_KINDS; i++) {
+			const struct mu_io_stats *v = &h->io[i];
+			MU_LOG("METROID UFS stats %s: calls=%llu errors=%llu ok-bytes=%llu service-us=%llu max-us=%llu\n",
+			    i == MU_IO_READ ? "read" : i == MU_IO_WRITE ? "write" : i == MU_IO_SYNC ? "sync" : "other",
+			    (unsigned long long)v->calls, (unsigned long long)v->errors,
+			    (unsigned long long)v->bytes, (unsigned long long)v->us, (unsigned long long)v->max_us);
+		}
+	}
+	return error;
+}
