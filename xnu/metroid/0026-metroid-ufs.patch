@@ -0,0 +1,15 @@
+/* Metroid UFS v5. Nothing SM8735 kernel031e8669 is the platform/protocol
+ * reference. Caller provides serialized access, permanent contiguous memory,
+ * MMIO/cache/time hooks, and the firmware-supplied external power contract.
+ * Files are ordered by dependency; no global Linux reset/driver state is used.
+ */
+#ifndef METROID_UFS_H
+#define METROID_UFS_H
+#include "metroid_ufs_base.h"
+#include "metroid_ufs_smmu.h"
+#include "metroid_ufs_uic.h"
+#include "metroid_ufs_niobe.h"
+#include "metroid_ufs_qcom.h"
+#include "metroid_ufs_hci.h"
+#include "metroid_ufs_device.h"
+#endif
