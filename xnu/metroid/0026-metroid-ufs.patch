diff --git a/bsd/dev/metroid_ufs_qcom.h b/bsd/dev/metroid_ufs_qcom.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/metroid_ufs_qcom.h
@@ -0,0 +1,337 @@
+/* SM8735/Tuna + Niobe platform operations, following Nothing031e8669:
+ * ufs_qcom_device_reset, hba_execute_hce callbacks, link_startup callbacks.
+ * External RPMh/PMIC votes are a firmware-provided board prerequisite. This
+ * provider never pretends that powered GDSCs replace regulator ownership.
+ * No shared PLL, display clock or global SMMU reset is performed here.
+ */
+static int
+mu_io_poll(uintptr_t addr, uint32_t mask, uint32_t want, uint32_t timeout)
+{
+	uint64_t start = MU_NOW_US();
+	do {
+		if ((MU_READ32(addr) & mask) == want) { return 0; }
+		MU_DELAY(10);
+	} while (MU_NOW_US() - start < timeout);
+	return ETIMEDOUT;
+}
+static int
+mu_io_update(uintptr_t addr, uint32_t mask, uint32_t value)
+{
+	uint32_t old = MU_READ32(addr);
+	if (old == 0xffffffffu) { return ENXIO; }
+	MU_WRITE32(addr, (old & ~mask) | (value & mask)); MU_BARRIER();
+	uint32_t got = MU_READ32(addr);
+	if ((got & mask) == (value & mask)) { return 0; }
+	MU_LOG("METROID UFS: MMIO addr=%llx mask=%08x want=%08x got=%08x\n",
+	    (unsigned long long)addr, mask, value & mask, got);
+	return EIO;
+}
+static uint32_t
+mu_clock_mhz(uint32_t cfg)
+{
+	if (cfg & (3u << 12)) { return 0; }
+	uint32_t source = (cfg >> 8) & 7, div = cfg & 31;
+	if (source == 6 && div == 5) { return 100; }
+	if (source == 5 && div == 7) { return 202; }
+	if (source == 5 && div == 3) { return 403; }
+	return 0;
+}
+static int
+mu_qcom_resources(struct mu_host *h)
+{
+	h->phase = "platform-resources";
+	if (!h->phy || !h->gcc || !h->reset || (mu_r(h, MU_QCOM_HW_VERSION) >> 28) != 6) { return ENOTSUP; }
+	uint32_t domains[] = { MU_READ32(h->gcc + 0x77004), MU_READ32(h->gcc + 0x9e000) };
+	h->core_mhz = mu_clock_mhz(MU_READ32(h->gcc + 0x77038));
+	h->unipro_mhz = mu_clock_mhz(MU_READ32(h->gcc + 0x770a8));
+	/* SYS1CLK uses integer MHz floor; UniPro's table rounds201.5 up202. */
+	if (h->core_mhz == 202) { h->core_mhz = 201; }
+	MU_LOG("METROID UFS: resources GDSC=%08x/%08x SYS1CLK=%u UniPro=%u\n",
+	    domains[0], domains[1], h->core_mhz, h->unipro_mhz);
+	uint32_t aux = MU_READ32(h->gcc + 0x770c4);
+	for (unsigned i = 0; i < 2; i++) {
+		if (domains[i] == 0xffffffffu || !(domains[i] & (1u << 31))) { return ENXIO; }
+	}
+	if (!h->core_mhz || !h->unipro_mhz || (aux & (7u << 8)) ||
+	    ((aux & 31) != 1 && (aux & 31) != 3)) { return ENXIO; }
+	/* Same board hint used by Nothing's host parameter initialization. */
+	h->phy_gear = ((mu_r(h, 0x284c) >> 4) & 15) >= 4 ? 5 : 4;
+	const uint32_t clocks[] = { 0x77028, 0x77018, 0x770f4, 0x7706c, 0x7707c, 0x770bc };
+	h->phase = "platform-clocks";
+	for (unsigned i = 0; i < sizeof(clocks) / sizeof(clocks[0]); i++) {
+		/* clk_branch2 enable: preserve HW-control and memory-retention fields. */
+		int error = mu_io_update(h->gcc + clocks[i], 1, 1);
+		if (error) { return error; }
+		error = mu_io_poll(h->gcc + clocks[i], 1u << 31, 0, 10000);
+		if (error) {
+			MU_LOG("METROID UFS: clock off=%x CBCR=%08x errno=%d\n", clocks[i], MU_READ32(h->gcc + clocks[i]), error);
+			return error;
+		}
+	}
+	/* Nothing forces retention of AXI/ICE memories on this major6 host. */
+	int error = mu_io_update(h->gcc + 0x77018, 1u << 14, 1u << 14);
+	if (!error) { error = mu_io_update(h->gcc + 0x7707c, 1u << 14, 1u << 14); }
+	MU_LOG("METROID UFS: firmware supply provider; core=%u UniPro=%u MHz Niobe G%u RateB\n",
+	    h->core_mhz, h->unipro_mhz, h->phy_gear);
+	return error;
+}
+static int
+mu_qcom_device_reset(struct mu_host *h)
+{
+	h->phase = "device-reset";
+	/* Dedicated Tuna UFS_RESET pad191, output bit0, active low. */
+	int error = mu_io_update(h->reset, 1, 0);
+	if (error) { return error; }
+	MU_DELAY(10);
+	h->phase = "core-reset";
+	error = mu_io_update(h->gcc + 0x77000, 1, 1);
+	if (!error) {
+		/* Major6: external PHY rails/GDSC stay powered while BCR is held.
+		 * Already-powered provider is a no-op, like Linux is_phy_pwr_on. */
+		MU_DELAY(200);
+		error = mu_io_update(h->gcc + 0x77000, 1, 0);
+		MU_DELAY(1000);
+	}
+	if (!error) {
+		error = mu_io_update(h->regs + MU_QCOM_CFG1, MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK,
+		    MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK);
+		MU_DELAY(60);
+	}
+	/* Always release both reset lines; never leave a failed boot holding them. */
+	if (error) { (void)mu_io_update(h->gcc + 0x77000, 1, 0); }
+	int release = mu_io_update(h->reset, 1, 1);
+	MU_DELAY(10);
+	return error ? error : release;
+}
+static void
+mu_phy_table(struct mu_host *h, const struct mu_phy_setting *table, unsigned count)
+{
+	for (unsigned i = 0; i < count; i++) { MU_WRITE32(h->phy + table[i].off, table[i].value); }
+	MU_BARRIER();
+}
+static int
+mu_qcom_phy_init(struct mu_host *h)
+{
+	h->phase = "phy-calibrate";
+	const uint32_t lanes[] = { 0x77030, 0x770d8, 0x7702c };
+	const uint32_t muxes[] = { 0x77068, 0x770ec, 0x77058 };
+	int error = 0;
+	for (unsigned i = 0; i < 3; i++) {
+		error = mu_io_update(h->gcc + lanes[i], 1, 0);
+		if (!error) { error = mu_io_update(h->gcc + muxes[i], 3, 2); }
+		if (error) { return error; }
+	}
+	error = mu_io_update(h->phy + 0x13e0, 1u << 6, 0);
+	if (!error) { error = mu_io_update(h->phy + 0x1be0, 1u << 6, 0); }
+	if (!error) { error = mu_io_update(h->phy + 0x404, 1, 1); }
+	if (error) { return error; }
+	error = mu_io_update(h->regs + MU_QCOM_CFG1, 2, 2);
+	if (error) { return error; }
+	MU_DELAY(1000);
+	error = mu_io_update(h->phy + 0x408, 1, 1);
+	if (error) { goto release_reset; }
+	mu_phy_table(h, mu_phy_rate_A_g5, sizeof(mu_phy_rate_A_g5) / sizeof(mu_phy_rate_A_g5[0]));
+	if (h->phy_gear == 4) { mu_phy_table(h, mu_phy_rate_A_g4, sizeof(mu_phy_rate_A_g4) / sizeof(mu_phy_rate_A_g4[0])); }
+	mu_phy_table(h, mu_phy_2nd_lane, sizeof(mu_phy_2nd_lane) / sizeof(mu_phy_2nd_lane[0]));
+	mu_phy_table(h, mu_phy_rate_B, sizeof(mu_phy_rate_B) / sizeof(mu_phy_rate_B[0]));
+release_reset:
+	{
+		int released = mu_io_update(h->phy + 0x408, 1, 0);
+		int host_release = mu_io_update(h->regs + MU_QCOM_CFG1, 2, 0);
+		MU_DELAY(1000);
+		if (!error) { error = released ? released : host_release; }
+	}
+	if (error) { return error; }
+	error = mu_io_update(h->phy + 0x400, 1, 1);
+	if (error) { return error; }
+	h->phase = "phy-pcs-ready";
+	error = mu_io_poll(h->phy + 0x5a8, 1, 1, 1000000);
+	if (error) { return error; }
+	for (unsigned i = 0; i < 3; i++) {
+		error = mu_io_update(h->gcc + muxes[i], 3, 0);
+		if (!error) { error = mu_io_update(h->gcc + lanes[i], 1, 1); }
+		if (error) { return error; }
+		MU_DELAY(10);
+	}
+	/* select_unipro_mode: source RMW, not an undocumented readback contract. */
+	mu_w(h, MU_QCOM_CFG1, mu_r(h, MU_QCOM_CFG1) | 1);
+	return mu_io_update(h->regs + 0xd8, (1u << 5) | 1, 0);
+}
+static int
+mu_qcom_hce_enable(struct mu_host *h)
+{
+	h->phase = "hce-disable";
+	mu_w(h, 0x34, 0);
+	int error = mu_poll(h, false, 0x34, 1, 0, 10000);
+	if (error) { return error; } /* no new command until old UIC engine stopped */
+	error = mu_qcom_phy_init(h);
+	if (error) { return error; }
+	h->phase = "hce-enable";
+	mu_w(h, 0x34, 1); MU_DELAY(1000);
+	error = mu_poll(h, false, 0x34, 1, 1, 50000);
+	if (error) { return error; }
+	mu_w(h, 0x18, 0); mu_w(h, 0x24, 0);
+	mu_w(h, 0x20, mu_r(h, 0x20));
+	uint64_t start = MU_NOW_US();
+	do {
+		error = mu_uic(h, 1, MU_TX_FSM_ATTRIBUTE, 0, &h->tx_fsm);
+		if (error || h->tx_fsm == MU_TX_FSM_HIBERN8) { return error; }
+		MU_DELAY(100);
+	} while (MU_NOW_US() - start < 100000);
+	return ETIMEDOUT;
+}
+static int
+mu_qcom_link_pre(struct mu_host *h)
+{
+	h->phase = "link-config";
+	mu_w(h, 0xc0, h->core_mhz);
+	if (mu_r(h, 0xc0) != h->core_mhz) { return EIO; }
+	/* Match scale_up=true in Nothing. Recovery403MHz: D002=01930300,
+	 * PA_VS_CORE_CLK_40NS_CYCLES=10; DIV_EN bit8 must not be cleared. */
+	int error = mu_dme_update(h, 0xd002, (0xfffu << 16) | (1u << 8), (h->unipro_mhz << 16) | (1u << 8));
+	if (!error) { error = mu_dme_update(h, 0x9007, 0x3f, h->unipro_mhz == 403 ? 16 : h->unipro_mhz == 202 ? 8 : 4); }
+	if (!error) { error = mu_dme_update(h, 0xa00b, 0x3ff, 0x3ff); }
+	if (!error) { error = mu_dme_update(h, 0x9004, 0x1ff, 0x1ff); }
+	if (!error) { error = mu_dme_update(h, 0xd002, 1u << 9, 1u << 9); }
+	if (!error) { error = mu_io_update(h->regs + 0xe0, 0xff, 0xff); }
+	if (!error) { error = mu_io_update(h->regs + 0xfc, (1u << 11) | (1u << 12), (1u << 11) | (1u << 12)); }
+	if (!error) { error = mu_io_update(h->phy + 0x57c, 2, 0); }
+	if (!error) { error = mu_io_update(h->regs + MU_QCOM_CFG1, MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK, MU_QCOM_REF_CLK | MU_QCOM_NO_ICE_CHECK); }
+	if (!error) { error = mu_dme_update(h, 0x155e, 1, 0); }
+	uint32_t clock = 0, timing = 0;
+	if (!error) { error = mu_uic(h, 1, 0xd002u << 16, 0, &clock); }
+	if (!error) { error = mu_uic(h, 1, 0x9007u << 16, 0, &timing); }
+	if (!error) { MU_LOG("METROID UFS: UniPro clocks D002=%08x 9007=%08x\n", clock, timing); }
+	return error;
+}
+static int
+mu_qcom_start(struct mu_host *h)
+{
+	int error = mu_qcom_resources(h);
+	if (error) { return error; }
+	error = mu_qcom_device_reset(h);
+	if (error) { return error; }
+	error = mu_qcom_hce_enable(h);
+	if (error) { return error; }
+	/* ufshcd_link_startup: unknown device state needs two successful phases;
+	 * each phase has its own initial attempt plus three HCE/PHY recoveries. */
+	for (unsigned pass = 1; pass <= 2; pass++) {
+		for (unsigned attempt = 1; attempt <= 4; attempt++) {
+			error = mu_qcom_link_pre(h);
+			if (error) { return error; }
+			mu_link_errors(h, "startup-before");
+			mu_w(h, 0x20, 1u << 2);
+			h->phase = "link-startup";
+			MU_LOG("METROID UFS: LINK_STARTUP pass=%u/2 attempt=%u/4\n", pass, attempt);
+			error = mu_uic(h, 0x16, 0, 0, NULL);
+			mu_link_errors(h, "startup-after");
+			/* A nominal command completion cannot hide fresh PA_INIT or
+			 * DME failure. Plain startup LINERESET alone is expected. */
+			if (!error && (((h->link_errors[1] & 0x80002000u) == 0x80002000u) ||
+			    ((h->link_errors[4] & 0x80000001u) == 0x80000001u))) { error = EIO; }
+			if (!error) {
+				if (!(mu_r(h, 0x30) & 1)) { return ENXIO; }
+				break;
+			}
+			/* No transfer/task queue has started. Recover local UIC engine
+			 * only; never clear/abort/reuse a timed-out DMA request. */
+			uint32_t fatal = mu_r(h, 0x20) & (MU_FATAL_IS & ~(1u << 2));
+			uint32_t fault = mu_sr(h, mu_cb(h, h->cb) + 0x58) & MU_SMMU_FSR_FAULT;
+			if (fatal || fault || attempt == 4) { return error; }
+			error = mu_qcom_hce_enable(h);
+			if (error) { return error; }
+		}
+	}
+	uint32_t connected = 0;
+	error = mu_uic(h, 1, 0x1561u << 16, 0, &connected);
+	if (error) { return error; }
+	if (!connected || connected > 2) { return EIO; }
+	(void)mu_r(h, 0x38); /* Linux consumes startup LINERESET before requests. */
+	MU_LOG("METROID UFS: link ready PCS=%08x HCS=%08x lanes=%u\n", MU_READ32(h->phy + 0x5a8), mu_r(h, 0x30), connected);
+	return 0;
+}
+/* High-speed G1..G3: external supplies and interconnect votes are
+ * still inherited. Linux's ufshcd_change_power_mode + QCOM PRE/POST_CHANGE,
+ * capped at G3; G4/G5 adaptation and device tuning remain unimplemented.
+ * No fallback after mutation: an uncertain link must never service disk I/O. */
+static int
+mu_hs_mode(struct mu_host *h, uint32_t cap)
+{
+	if (!cap || cap > 3) { return EINVAL; }
+	if (h->failed || h->state != MU_LINK_READY || !h->mapped) { return EIO; }
+	if (mu_r(h, 0x58) || mu_r(h, 0x78)) { return EBUSY; }
+	h->phase = "hs-capabilities";
+	uint32_t rx = 0, tx = 0, rxmax = 0, txmax = 0;
+	int error = mu_uic(h, 1, 0x1581u << 16, 0, &rx);
+	if (!error) { error = mu_uic(h, 1, 0x1561u << 16, 0, &tx); }
+	if (!error) { error = mu_uic(h, 1, 0x1587u << 16, 0, &rxmax); }
+	if (!error) { error = mu_uic(h, 3, 0x1587u << 16, 0, &txmax); } /* peer RX */
+	if (error) { return error; }
+	if (!rx || rx > 2 || !tx || tx > 2 || !rxmax || rxmax > 5 || !txmax || txmax > 5) { return ENOTSUP; }
+	uint32_t gear = cap < rxmax ? cap : rxmax;
+	if (gear > txmax) { gear = txmax; }
+	/* REF_CLK was enabled and settled before link startup. Preserve the
+ * calibrated Rate-B PHY and actual-rate SYS1CLK/UniPro timer settings. */
+	if ((mu_r(h, MU_QCOM_CFG1) & MU_QCOM_REF_CLK) == 0 ||
+	    mu_r(h, 0xc0) != h->core_mhz) { return EIO; }
+	h->phase = "hs-config";
+	const struct { uint16_t attr; uint32_t value; } settings[] = {
+		{ 0x15d4, 3 }, /* PA_TXHSADAPTTYPE = PA_NO_ADAPT for G1..G3 */
+		{ 0x1583, gear }, { 0x1580, rx }, { 0x1584, 1 },
+		{ 0x1568, gear }, { 0x1560, tx }, { 0x1569, 1 },
+		{ 0x156a, 2 }, /* PA_HSSERIES = Rate B */
+		{ 0x15b0, 8191 }, { 0x15b1, 65535 }, { 0x15b2, 32767 },
+		{ 0x15b3, 8191 }, { 0x15b4, 65535 }, { 0x15b5, 32767 },
+		{ 0xd041, 8191 }, { 0xd042, 65535 }, { 0xd043, 32767 },
+	};
+	for (unsigned i = 0; i < sizeof(settings) / sizeof(settings[0]); i++) {
+		error = mu_uic_command(h, 2, (uint32_t)settings[i].attr << 16, settings[i].value, 0, NULL);
+		if (error) { goto failed; }
+	}
+	h->phase = "hs-power-mode";
+	/* FAST/FAST: UIC completion alone is insufficient; wait for UPMS and
+ * require UPMCRS=PWR_LOCAL, exactly like ufshcd_uic_pwr_ctrl. */
+	error = mu_uic_command(h, 2, 0x1571u << 16, 0x11, 1u << 4, NULL);
+	if (error) { goto failed; }
+	h->phase = "hs-verify";
+	const struct { uint16_t attr; uint32_t value; } verify[] = {
+		{ 0x1571, 0x11 }, { 0x1583, gear }, { 0x1568, gear },
+		{ 0x1580, rx }, { 0x1560, tx }, { 0x156a, 2 },
+	};
+	for (unsigned i = 0; i < sizeof(verify) / sizeof(verify[0]); i++) {
+		uint32_t actual = 0;
+		error = mu_uic(h, 1, (uint32_t)verify[i].attr << 16, 0, &actual);
+		if (!error && actual != verify[i].value) { error = EIO; }
+		if (error) { goto failed; }
+	}
+	if ((mu_r(h, 0x20) & MU_FATAL_IS) ||
+	    (mu_sr(h, mu_cb(h, h->cb) + 0x58) & MU_SMMU_FSR_FAULT)) { error = EIO; goto failed; }
+	MU_LOG("METROID UFS: HS-G%u Rate-B FAST/FAST verified RX-lanes=%u TX-lanes=%u (requested cap=%u)\n", gear, rx, tx, cap);
+	return 0;
+failed:
+	mu_fail(h); mu_dump(h, "hs-failed"); return error;
+}
+
+static int
+mu_start_host(struct mu_host *h)
+{
+	if (!h->mapped || h->failed) { return EIO; }
+	if (h->state != MU_DMA_READY || mu_r(h, 0x58) || mu_r(h, 0x78) ||
+	    (mu_r(h, 0x60) & 1) || (mu_r(h, 0x80) & 1)) { return EBUSY; }
+	int error = mu_qcom_start(h);
+	if (error) { mu_fail(h); mu_dump(h, "platform-failed"); return error; }
+	h->phase = "queue-start";
+	error = mu_poll(h, false, 0x30, 0xf, 0xf, 1000000);
+	if (error) { mu_fail(h); return error; }
+	mu_w(h, 0x4c, 0); mu_w(h, 0x20, mu_r(h, 0x20));
+	mu_w(h, 0x50, (uint32_t)MU_IOVA); mu_w(h, 0x54, 0);
+	mu_w(h, 0x70, (uint32_t)(MU_IOVA + MU_TASK)); mu_w(h, 0x74, 0);
+	MU_FLUSH((uintptr_t)h->pool, MU_POOL_SIZE); MU_BARRIER();
+	if (mu_r(h, 0x50) != MU_IOVA || mu_r(h, 0x54) ||
+	    mu_r(h, 0x70) != MU_IOVA + MU_TASK || mu_r(h, 0x74)) { mu_fail(h); return EIO; }
+	mu_w(h, 0x80, 1); mu_w(h, 0x60, 1);
+	error = mu_poll(h, false, 0x60, 1, 1, 10000);
+	if (error) { mu_fail(h); return error; }
+	h->state = MU_LINK_READY;
+	return 0;
+}
diff --git a/bsd/dev/metroid_ufs_smmu.h b/bsd/dev/metroid_ufs_smmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/metroid_ufs_smmu.h
@@ -0,0 +1,216 @@
+/* Per-UFS SMMUv2 stage1 domain; preserve all other firmware streams.
+ * arm-smmu/qsmmuv500 and fastmap reference: Nothing031e8669. */
+static bool
+mu_smr_matches(uint32_t smr)
+{
+	uint32_t mask = (smr >> 16) & 0x7fff;
+	return (smr & (1u << 31)) && !(((smr & 0xffff) ^ MU_SID) & ~mask);
+}
+
+/* Find the exact UFS stream, then allocate a fresh stage-1 context bank.
+ * Every context referenced by firmware, including UFS, remains reserved.
+ * No global reset, CLIENTPD change or unrelated-stream TLB invalidation. */
+static int
+mu_choose_context(struct mu_host *h)
+{
+	uint32_t id0 = mu_sr(h, 0x20), id1 = mu_sr(h, 0x24), id2 = mu_sr(h, 0x28);
+	uint32_t scr0 = mu_sr(h, 0);
+	MU_LOG("METROID SMMU: ID0=%08x ID1=%08x ID2=%08x CR0=%08x\n", id0, id1, id2, scr0);
+	if (!id0 || id0 == UINT32_MAX || !id1 || id1 == UINT32_MAX || id2 == UINT32_MAX ||
+	    !(id0 & (1u << 30)) || !(id0 & (1u << 27)) || !(id2 & (1u << 12)) ||
+	    (scr0 & ((1u << 0) | (1u << 3)))) {
+		MU_LOG("METROID SMMU: need active SMMUv2 stage-1/4K/SMR, no extended IDs; ID=%08x/%08x/%08x CR0=%08x\n", id0, id1, id2, scr0);
+		return ENOTSUP;
+	}
+	h->pgshift = (id1 & (1u << 31)) ? 16 : 12;
+	h->gr1 = 1u << h->pgshift;
+	h->cb_base = (1u << (((id1 >> 28) & 7) + 1)) << h->pgshift;
+	h->ncb = id1 & 0xff;
+	h->ns2cb = (id1 >> 16) & 0xff;
+	h->nsmr = id0 & 0xff;
+	/* Stage-1 output width is ID2.IAS (IPA width), not ID2.OAS. */
+	h->ips = id2 & 0xf;
+	/* QSMMUv500 exposes more than 128 SMR/S2CR groups (138 on Metroid).
+	 * Nothing's qsmmuv500_impl retains ID0.NUMSMRG; the generic Qualcomm
+	 * implementation's 128-group workaround is not installed for this IP.
+	 * The 8-bit count bounds both arrays of registers inside GR0: up to
+	 * SMR[254] at 0xbf8 and S2CR[254] at 0xff8. Context-bank bookkeeping
+	 * below is indexed by CBNDX, not by the number of streams.
+	 */
+	if (!h->ncb || h->ncb > 128 || !h->nsmr ||
+	    h->ns2cb >= h->ncb || h->ips > 5 ||
+	    (uint64_t)h->cb_base + ((uint64_t)h->ncb << h->pgshift) > 0x100000) {
+		MU_LOG("METROID SMMU: unsupported geometry: page_shift=%u CB_base=%x contexts=%u stage2_only=%u SMRs=%u IPS=%u aperture=100000\n",
+		    h->pgshift, h->cb_base, h->ncb, h->ns2cb, h->nsmr, h->ips);
+		return ENOTSUP;
+	}
+	bool referenced[128] = { false }, used_asid[256] = { false };
+	uint32_t matches = 0, free_smr = UINT32_MAX;
+	h->smr = UINT32_MAX;
+	for (uint32_t i = 0; i < h->nsmr; i++) {
+		uint32_t s = mu_sr(h, 0x800 + 4 * i), c = mu_sr(h, 0xc00 + 4 * i);
+		if (!(s & (1u << 31))) { if (free_smr == UINT32_MAX) { free_smr = i; } continue; }
+		if (mu_smr_matches(s)) { h->smr = i; matches++; }
+		if (((c >> 16) & 3) == 0 && (c & 0xff) < h->ncb) { referenced[c & 0xff] = true; }
+	}
+	if (matches > 1) { return EBUSY; }
+	h->cb = UINT32_MAX;
+	if (matches == 1) {
+		h->old_smr = mu_sr(h, 0x800 + 4 * h->smr);
+		h->old_s2cr = mu_sr(h, 0xc00 + 4 * h->smr);
+		if (h->old_smr != ((1u << 31) | MU_SID)) { return EBUSY; }
+
+	} else {
+		if (free_smr == UINT32_MAX) { return ENOSPC; }
+		h->smr = free_smr;
+		h->old_smr = mu_sr(h, 0x800 + 4 * h->smr);
+		h->old_s2cr = mu_sr(h, 0xc00 + 4 * h->smr);
+	}
+	for (uint32_t i = h->ns2cb; i < h->ncb; i++) {
+		uint32_t b = mu_cb(h, i);
+		uint64_t ttbr = mu_sr64(h, b + 0x20), ttbr1 = mu_sr64(h, b + 0x28);
+		used_asid[(ttbr >> 48) & 0xff] = true;
+		used_asid[(ttbr1 >> 48) & 0xff] = true;
+		if (h->cb == UINT32_MAX && !referenced[i] && !(mu_sr(h, b) & 1)) { h->cb = i; }
+	}
+	if (h->cb == UINT32_MAX) {
+		MU_LOG("METROID SMMU: no unused disabled stage-1 context; firmware contexts preserved\n");
+		return ENOSPC;
+	}
+	MU_LOG("METROID SMMU: allocate fresh CB=%u; firmware UFS S2CR=%08x is preserved until attach\n",
+	    h->cb, h->old_s2cr);
+	h->asid = 0;
+	for (uint32_t i = 1; i < 256; i++) { if (!used_asid[i]) { h->asid = i; break; } }
+	return h->asid ? 0 : ENOSPC;
+}
+
+/* Three 4K tables: 32-bit IOVA -> L1 (four entries) -> L2 -> L3.
+ * Only the DMA pool is mapped; neighbouring pages and all other IOVAs fault.
+ * SMMU's 4K granule is independent of the CPU's 16K XNU page size. */
+static int
+mu_build_tables(struct mu_host *h)
+{
+	static const uint8_t pa_bits[] = { 32, 36, 40, 42, 44, 48 };
+	if (!h->tables || !h->pool || h->ips > 5 || (h->pool_pa & 4095) ||
+	    (h->tables_pa & 4095) || h->pool_pa > (1ull << pa_bits[h->ips]) - MU_POOL_SIZE ||
+	    h->tables_pa > (1ull << pa_bits[h->ips]) - MU_TABLE_SIZE) { return EINVAL; }
+	memset(h->tables, 0, MU_TABLE_SIZE);
+	uint64_t *l1 = h->tables, *l2 = l1 + 512, *l3 = l2 + 512;
+	l1[(MU_IOVA >> 30) & 3] = (h->tables_pa + 0x1000) | 3;
+	l2[(MU_IOVA >> 21) & 511] = (h->tables_pa + 0x2000) | 3;
+	for (uint32_t i = 0; i < MU_POOL_SIZE / 4096; i++) {
+		/* AF, inner-shareable, unprivileged R/W, AttrIdx0 WB, nG, XN. */
+		l3[i] = (h->pool_pa + (uint64_t)i * 4096) | 3 | (1u << 6) |
+		    (3u << 8) | (1u << 10) | (1u << 11) | (3ull << 53);
+	}
+	MU_CLEAN((uintptr_t)h->tables, MU_TABLE_SIZE);
+	MU_BARRIER();
+	return 0;
+}
+
+static int
+mu_tlb_sync(struct mu_host *h, uint32_t asid)
+{
+	uint32_t b = mu_cb(h, h->cb);
+	mu_sw(h, b + 0x610, asid);
+	mu_sw(h, b + 0x7f0, 0);
+	return mu_poll(h, true, b + 0x7f4, 1, 0, 100000);
+}
+
+/* Linux writes configuration without whole-register equality checks.
+ * Report normalization, but only reject differences that would change the
+ * translation format, page-table address, or UFS stream destination. */
+static int
+mu_check32(struct mu_host *h, uint32_t off, uint32_t want, uint32_t mask, const char *name)
+{
+	uint32_t got = mu_sr(h, off);
+	if (got != want) {
+		MU_LOG("METROID SMMU: %s readback want=%08x got=%08x required=%08x %s\n",
+		    name, want, got, mask, ((got ^ want) & mask) ? "blocked/incompatible" : "continuing");
+	}
+	return ((got ^ want) & mask) ? EPERM : 0;
+}
+
+static int
+mu_check_ttbr(struct mu_host *h, uint32_t off, uint64_t want)
+{
+	uint64_t got = mu_sr64(h, off);
+	const uint64_t mask = MU_ADDR_MASK | (0xffffull << 48);
+	if (got != want) {
+		MU_LOG("METROID SMMU: TTBR0 readback want=%llx got=%llx %s\n",
+		    (unsigned long long)want, (unsigned long long)got,
+		    ((got ^ want) & mask) ? "blocked/incompatible" : "continuing");
+	}
+	return ((got ^ want) & mask) ? EPERM : 0;
+}
+
+static int
+mu_map_dma(struct mu_host *h)
+{
+	h->phase = "dma-map";
+	if (mu_r(h, 0x58) || mu_r(h, 0x78) || (mu_r(h, 0x60) & 1) || (mu_r(h, 0x80) & 1)) { return EBUSY; }
+	int error = mu_choose_context(h);
+	if (error) { return error; }
+	/* Nothing's qsmmuv500_cfg_probe clears only this implementation bit.
+	 * Firmware may protect it; preserve every other sACR bit and report
+	 * blocked writes like Linux, without resetting global SMMU state. */
+	uint32_t acr = mu_sr(h, 0x10);
+	if (acr & (1u << 26)) {
+		mu_sw(h, 0x10, acr & ~(1u << 26));
+		MU_LOG("METROID SMMU: CACHE_LOCK old=%08x new=%08x%s\n", acr, mu_sr(h, 0x10),
+		    (mu_sr(h, 0x10) & (1u << 26)) ? " firmware-locked" : " cleared");
+	}
+	error = mu_build_tables(h);
+	if (error) { return error; }
+	uint32_t b = mu_cb(h, h->cb);
+	/* The UFS engines are stopped. Keep this context disabled on failure;
+	 * the permanent pool/tables remain pinned for any late device accesses. */
+	h->configured = true; h->state = MU_DMA_READY;
+	uint32_t old_asid = (uint32_t)(mu_sr64(h, b + 0x20) >> 48);
+	mu_sw(h, b, 0);
+	if ((error = mu_check32(h, b, 0, 1, "SCTLR disable"))) { goto fail; }
+	if (mu_tlb_sync(h, old_asid)) { error = ETIMEDOUT; goto fail; }
+	uint32_t cbar = (1u << 16) | (0xfu << 12) | (3u << 8);
+	/* Linux io-pgtable's noncoherent-walk case: outer-shareable, inner
+	 * and outer noncacheable table reads. Tables are explicitly cleaned
+	 * above and immutable while attached; firmware coherency is not assumed.
+	 * Endpoint PTEs remain Normal WB and use explicit cache ownership below. */
+	uint32_t tcr = (1u << 23) | (2u << 12) | 32;
+	uint32_t tcr2 = (7u << 15) | h->ips; /* 8-bit ASID; TCR2.AS stays zero */
+	uint64_t ttbr = h->tables_pa | ((uint64_t)h->asid << 48);
+	mu_sw(h, h->gr1 + 0x800 + 4 * h->cb, 1); /* AArch64 */
+	mu_sw(h, h->gr1 + 4 * h->cb, cbar);
+	mu_sw(h, b + 0x10, tcr2);
+	mu_sw(h, b + 0x30, tcr);
+	mu_sw64(h, b + 0x20, ttbr);
+	mu_sw64(h, b + 0x28, 0);
+	mu_sw(h, b + 0x38, 0xff); /* MAIR0 Attr0: Normal WB */
+	mu_sw(h, b + 0x3c, 0);
+	mu_sw(h, b + 0x58, mu_sr(h, b + 0x58) & MU_SMMU_FSR_FAULT);
+	if ((error = mu_check32(h, h->gr1 + 0x800 + 4 * h->cb, 1, 1, "CBA2R VA64")) ||
+	    (error = mu_check32(h, h->gr1 + 4 * h->cb, cbar, 3u << 16, "CBAR stage")) ||
+	    (error = mu_check32(h, b + 0x10, tcr2, 0xf, "TCR2 PA size")) ||
+	    (error = mu_check32(h, b + 0x30, tcr, (1u << 23) | (1u << 22) | (3u << 14) | (1u << 7) | 0x3f, "TCR format")) ||
+	    (error = mu_check_ttbr(h, b + 0x20, ttbr)) ||
+	    (error = mu_check32(h, b + 0x38, 0xff, 0xff, "MAIR Attr0"))) { goto fail; }
+	if (mu_tlb_sync(h, h->asid)) { error = ETIMEDOUT; goto fail; }
+	/* Abort on faults rather than stall forever; poll FSR instead of using IRQ. */
+	uint32_t sctlr = (1u << 12) | (1u << 5) | (1u << 2) | (1u << 1) | 1;
+	mu_sw(h, b, sctlr);
+	if ((error = mu_check32(h, b, sctlr, 1, "SCTLR enable"))) { goto fail; }
+	/* Linux uses TRANS + PRIVCFG_DEFAULT when attaching a DMA domain. */
+	uint32_t s2cr = h->cb;
+	mu_sw(h, 0xc00 + 4 * h->smr, s2cr);
+	if ((error = mu_check32(h, 0xc00 + 4 * h->smr, s2cr, (3u << 16) | 0xff, "S2CR route"))) { goto fail; }
+	mu_sw(h, 0x800 + 4 * h->smr, (1u << 31) | MU_SID);
+	if ((error = mu_check32(h, 0x800 + 4 * h->smr, (1u << 31) | MU_SID, UINT32_MAX, "SMR match"))) { goto fail; }
+	h->mapped = true;
+	MU_LOG("METROID DMA: SID=60 SMR=%u CB=%u ASID=%u IOVA=%llx PA=%llx bytes=%x TTBR=%llx (NC table walks, explicit cache sync)\n",
+	    h->smr, h->cb, h->asid, (unsigned long long)MU_IOVA,
+	    (unsigned long long)h->pool_pa, MU_POOL_SIZE, (unsigned long long)h->tables_pa);
+	return 0;
+fail:
+	mu_sw(h, b, 0);
+	mu_fail(h);
+	return error;
+}
diff --git a/bsd/dev/metroid_ufs_uic.h b/bsd/dev/metroid_ufs_uic.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/metroid_ufs_uic.h
@@ -0,0 +1,57 @@
+/* UIC command engine: ufshcd_send_uic_cmd/ufshcd_uic_pwr_ctrl reference.
+ * Caller serializes access and drains transfer/task queues before power
+ * changes. Startup recovery is allowed only before those queues start.
+ */
+static void
+mu_link_errors(struct mu_host *h, const char *when)
+{
+	for (unsigned i = 0; i < 5; i++) { h->link_errors[i] = mu_r(h, 0x38 + 4 * i); }
+	MU_LOG("METROID UFS: %s PA=%08x DL=%08x NL=%08x TL=%08x DME=%08x IS=%08x HCS=%08x\n",
+	    when, h->link_errors[0], h->link_errors[1], h->link_errors[2],
+	    h->link_errors[3], h->link_errors[4], mu_r(h, 0x20), mu_r(h, 0x30));
+}
+
+static int
+mu_uic_command(struct mu_host *h, uint32_t command, uint32_t arg1,
+    uint32_t arg3, uint32_t power_event, uint32_t *value)
+{
+	h->uic_result = 0xffffffffu;
+	int error = mu_poll(h, false, 0x30, 1u << 3, 1u << 3, 500000);
+	if (error) { goto out; }
+	mu_w(h, 0x20, MU_UIC_DONE | power_event);
+	mu_w(h, 0x94, arg1); mu_w(h, 0x98, 0); mu_w(h, 0x9c, arg3);
+	mu_w(h, 0x90, command);
+	error = mu_poll(h, false, 0x20, MU_UIC_DONE, MU_UIC_DONE, 500000);
+	if (error) { goto out; }
+	h->uic_result = mu_r(h, 0x98) & 0xff;
+	mu_w(h, 0x20, MU_UIC_DONE);
+	if (h->uic_result) { error = EIO; goto out; }
+	if (value) { *value = mu_r(h, 0x9c); }
+	if (power_event) {
+		error = mu_poll(h, false, 0x20, power_event, power_event, 500000);
+		if (error) { goto out; }
+		uint32_t status = (mu_r(h, 0x30) >> 8) & 7;
+		mu_w(h, 0x20, power_event);
+		if (status != 1) { error = EIO; }
+	}
+out:
+	if (error) {
+		MU_LOG("METROID UFS: UIC cmd=%02x arg1=%08x arg3=%08x result=%08x errno=%d\n",
+		    command, arg1, arg3, h->uic_result, error);
+	}
+	return error;
+}
+static int
+mu_uic(struct mu_host *h, uint32_t command, uint32_t arg1,
+    uint32_t power_event, uint32_t *value)
+{
+	return mu_uic_command(h, command, arg1, 0, power_event, value);
+}
+static int
+mu_dme_update(struct mu_host *h, uint32_t attr, uint32_t mask, uint32_t value)
+{
+	uint32_t old;
+	int error = mu_uic(h, 1, attr << 16, 0, &old);
+	return error ? error : mu_uic_command(h, 2, attr << 16,
+	    (old & ~mask) | (value & mask), 0, NULL);
+}
