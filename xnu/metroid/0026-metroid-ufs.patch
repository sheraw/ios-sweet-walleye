+/* Keep ownership of slot zero/bounce memory while sleeping. Never block
+ * during early bootstrap, with IRQs masked, or in a non-preemptible context. */
+static bool
+metroid_ufs_wait_us(uint32_t us)
+{
+	static uint8_t wait_event;
+	if (!ml_get_interrupts_enabled() || get_preemption_level()) { return false; }
+	uint64_t interval;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &interval);
+	uint64_t deadline = mach_absolute_time() + interval;
+	if (assert_wait_deadline_with_leeway((event_t)&wait_event, THREAD_UNINT,
+	    TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0) != THREAD_WAITING) { return false; }
+	thread_block(THREAD_CONTINUE_NULL);
+	return true;
+}
 
+static uint64_t
+metroid_ufs_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
