+/* Render a completed row surface-by-surface, like the working probe. All
+ * layout/cursor values are snapshots: framebuffer stores cannot force the
+ * compiler to reload them from uncached RAM for every pixel. */
+static void commit_line(void)
+{
+    const unsigned line_row = row, length = col, line_cols = cols;
+    const unsigned n = count;
+    const uint64_t bias = fb_bias;
+
+    for (unsigned p = 0; p < n; p++) {
+        const struct surface surface = surfaces[p];
+        volatile uint32_t *fb = fb_pointer(surface.address + bias);
+        const unsigned pitch = surface.stride / 4;
+        for (unsigned gy = 0; gy < 16; gy++) {
+            for (unsigned sy = 0; sy < 2; sy++) {
+                uint64_t row_base_offset = (uint64_t)(160 + line_row * 32 + gy * 2 + sy) * pitch;
+
+                for (unsigned column = 0; column < line_cols; column++) {
+                    unsigned screen_x = 16 + column * 16;
+
+                    /* Split-pipe horizontal boundary clipping */
+                    if (screen_x + 16 <= surface.x || screen_x >= surface.x + surface.width) {
+                        continue;
+                    }
+                    /* surface.address is the shared buffer base; x is absolute. */
+                    unsigned local_x = screen_x;
+                    volatile uint32_t *dst = fb + row_base_offset + local_x;
+
+                    unsigned c = column < length ? (unsigned char)pending[column] : ' ';
+#ifdef METROID_XNU
+                    unsigned bits = iso_font[c * 16 + gy];
+#else
+                    unsigned bits = font8x16[c - 32][gy];
+#endif
+                    for (unsigned gx = 0; gx < 8; gx++) {
+#ifdef METROID_XNU
+                        unsigned ink = bits & (1u << gx);
+#else
+                        unsigned ink = bits & (0x80u >> gx);
+#endif
+                        uint32_t pixel = ink ? 0xffffffffu : surface.black;
+                        for (unsigned sx = 0; sx < 2; sx++) {
+                            unsigned x = screen_x + gx * 2 + sx;
+                            if (x >= surface.x && x < surface.x + surface.width)
+                                dst[gx * 2 + sx] = pixel;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // metroid_console_refresh();
+    col = 0;
+    row = (line_row + 1) % 70;
 }
