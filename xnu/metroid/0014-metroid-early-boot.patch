diff --git a/osfmk/arm64/metroid_console.c b/osfmk/arm64/metroid_console.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/metroid_console.c
@@ -0,0 +1,150 @@
+#define METROID_XNU 1
+/* Command-mode console using the firmware's validated, active linear pipes.
+ * Never changes display routing, buffer addresses, clocks, DSC or power.
+ * Single CPU, no allocator/locks. Refreshes on newline with a bounded delay.
+ */
+#include "metroid_console.h"
+#ifdef METROID_XNU
+extern unsigned char iso_font[256 * 16];
+#else
+#include "../shim/font.h"
+#endif
+static uintptr_t mdp = 0x0ae00000;
+static uint64_t fb_bias;
+static struct surface surfaces[28];
+static unsigned count, controllers, row, col, cols;
+static const uint32_t pipe_offsets[] = {0x5000,0x7000,0x25000,0x27000,0x29000,0x2b000,0x2d000};
+static const uint32_t pipe_bits[] = {16,17,0,1,2,3,4};
+#define SPLASH_START 0xfc800000ULL
+#define SPLASH_END 0xff300000ULL
+static uint32_t rd(uintptr_t a) { return *(volatile uint32_t *)a; }
+static int surface_decode(struct surface *s, uint32_t address, uint32_t size,
+                   uint32_t xy, uint32_t stride, uint32_t format,
+                   uint32_t unpack, uint32_t opmode, uint32_t secure,
+                   uint32_t multirect)
+{
+    uint32_t w = size & 0xffff, h = size >> 16;
+    uint32_t x = xy & 0xffff, y = xy >> 16;
+    stride &= 0xffff;
+    /* Exact 8-bit components, packed four-byte linear RGB, tight unpack.
+     * Reject YUV, tiling/UBWC, rotation, solid fill, FP16/DX and multirect.
+     */
+    if ((format & 0xff) != 0xff || ((format >> 9) & 3) != 3 ||
+        ((format >> 12) & 3) != 3 || !(format & (1u << 17)) ||
+        (format & ((3u << 30) | (3u << 19) | (3u << 23) |
+                   (1u << 22) | (1u << 16) | (1u << 15) |
+                   (1u << 14) | (1u << 11))) ||
+        (opmode & ((1u << 14) | (1u << 13) | 1)) ||
+        secure || multirect)
+        return 0;
+    if ((w != 630 && w != 1260) || h != 2800 || x > 1260 || y != 0 ||
+        stride % 4 || stride < (x + w) * 4 || stride > 16384)
+        return 0;
+    uint64_t end = (uint64_t)address + (uint64_t)(y + h - 1) * stride
+                   + (uint64_t)(x + w) * 4;
+    if (address % 4 || address < SPLASH_START || end > SPLASH_END)
+        return 0;
+    uint32_t seen = 0, black = 0;
+    for (unsigned i = 0; i < 4; ++i) {
+        unsigned element = (unpack >> (i * 8)) & 0xff;
+        if (element > 3 || (seen & (1u << element))) return 0;
+        seen |= 1u << element;
+        if (element == 3) black = 0xffu << (i * 8);
+    }
+    *s = (struct surface){address, w, h, stride, x, y, black};
+    return 1;
+}
+
+
+int metroid_console_init(void)
+{
+    count = controllers = row = col = 0; cols = 78;
+    for (unsigned c = 0; c < 4; c++) {
+        uintptr_t ctl = mdp + 0x16000 + c * 0x1000;
+        uint32_t intf = rd(ctl + 0xf4);
+        if (!intf || (intf & ~6u) || !(rd(ctl + 0x14) & (1u << 17)) ||
+            rd(ctl + 0xec) || rd(ctl + 0xf0)) continue;
+        uint32_t active = rd(ctl + 0x12c);
+        for (unsigned p = 0; p < 7; p++) {
+            if (!(active & (1u << pipe_bits[p]))) continue;
+            uintptr_t pipe = mdp + pipe_offsets[p];
+            struct surface s;
+            if (!surface_decode(&s, rd(pipe+0x14), rd(pipe), rd(pipe+8),
+                rd(pipe+0x24), rd(pipe+0x30), rd(pipe+0x34), rd(pipe+0x38),
+                rd(pipe+0x70), rd(pipe+0x170))) continue;
+            surfaces[count++] = s;
+            if (s.width / 16 < cols) cols = s.width / 16;
+            controllers |= 1u << c;
+        }
+    }
+
+    if (count > 0) {
+        uint64_t bias = fb_bias;
+        for (unsigned i = 0; i < count; i++) {
+            const struct surface s = surfaces[i];
+            volatile uint32_t *fb = fb_pointer(s.address + bias);
+            uint32_t pitch = s.stride / 4;
+            for (uint32_t y = 0; y < s.height; y++) {
+                volatile uint32_t *line = fb + (uint64_t)y * pitch;
+                for (uint32_t x = 0; x < s.width; x++) {
+                    line[x] = s.black;
+                }
+            }
+        }
+    }
+
+    return count != 0;
+}
+static void refresh(void)
+{
+    __asm__ volatile("dsb sy" ::: "memory");
+    for (unsigned c = 0; c < 4; c++)
+        if (controllers & (1u << c))
+            *(volatile uint32_t *)(mdp + 0x1601c + c * 0x1000) = 1;
+    __asm__ volatile("dsb sy" ::: "memory");
+    uint64_t start, now, hz;
+    __asm__ volatile("mrs %0, cntpct_el0" : "=r"(start));
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(hz));
+    do { __asm__ volatile("mrs %0, cntpct_el0" : "=r"(now)); }
+    while (now - start < hz / 10);
+}
+void metroid_console_putc(char ch)
+{
+    if (!count) return;
+    if (ch == '\r') { col = 0; return; }
+    if (ch == '\n' || col == cols) {
+        refresh(); col = 0; row = (row + 1) % 70;
+        if (ch == '\n') return;
+    }
+    unsigned c = (unsigned char)ch;
+    if (c < 32 || c > 126) c = '?';
+    for (unsigned p = 0; p < count; p++) {
+        const struct surface *s = &surfaces[p];
+        volatile uint32_t *fb = (void *)(uintptr_t)(s->address + fb_bias);
+        if (!col) {
+            for (unsigned y = 0; y < 32; y++)
+                for (unsigned x = 0; x < s->width; x++)
+                    fb[(uint64_t)(160 + row*32 + y)* (s->stride/4) + s->x+x] = s->black;
+        }
+        for (unsigned gy = 0; gy < 16; gy++)
+            for (unsigned gx = 0; gx < 8; gx++) {
+#ifdef METROID_XNU
+                unsigned ink = iso_font[c*16+gy] & (1u << gx);
+#else
+                unsigned ink = font8x16[c-32][gy] & (0x80u >> gx);
+#endif
+                for (unsigned sy = 0; sy < 2; sy++)
+                    for (unsigned sx = 0; sx < 2; sx++)
+                        fb[(uint64_t)(160+row*32+gy*2+sy)*(s->stride/4)+s->x+col*16+gx*2+sx] = ink ? 0xffffffffu : s->black;
+            }
+    }
+    col++;
+}
+void metroid_console_string(const char *s) { while (*s) metroid_console_putc(*s++); }
+void metroid_console_relocate(uint64_t base)
+{
+    fb_bias = base - 0xfc000000ULL;
+    mdp = (uintptr_t)base;
+    __asm__ volatile("dsb sy; isb" ::: "memory");
+}
+const struct surface *metroid_console_surface(void) { return count ? surfaces : (void *)0; }
