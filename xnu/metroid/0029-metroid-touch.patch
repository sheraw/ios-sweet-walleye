+/* Polled GENI SPI, full duplex, mode 0, 8-bit MSB-first, CS0.
+ * MT_RD(offset), MT_WR(offset,value), MT_DELAY(us) supplied by caller.
+ * Only this driver's command may be aborted. An uncertain bus is quarantined.
+ */
+#ifndef METROID_TOUCH_SPI_H
+#define METROID_TOUCH_SPI_H
+static unsigned mt_fifo_depth;
+static unsigned mt_clock_sel;
+static bool mt_dead;
+static bool
+mt_spi_init(void)
+{
+	uint32_t fw = MT_RD(0x68), tx = MT_RD(0xe24), rx = MT_RD(0xe28);
+	mt_fifo_depth = (tx >> 16) & 0x3f;
+	if (fw == 0xffffffffu || ((fw >> 8) & 0xff) != 1 ||
+	    (MT_RD(0x64) & 1) || MT_RD(0x40) & 0x1001 ||
+	    ((tx >> 24) & 0x3f) != 32 || mt_fifo_depth < 2 ||
+	    ((rx >> 16) & 0x3f) < 2 ||
+	    MT_RD(0x800) || MT_RD(0x804)) return false;
+	/* Do not route interrupts or DMA to unowned GIC/GPI channels. */
+	MT_WR(0xe18, 0); MT_WR(0xe1c, 0);
+	MT_WR(0x614, 0); MT_WR(0x644, 0);
+	MT_WR(0x618, 0xffffffffu); MT_WR(0x648, 0xffffffffu);
+	MT_WR(0x28, MT_RD(0x28) | 0x7f);
+	MT_WR(0xe30, MT_RD(0xe30) | 15);
+	MT_WR(0x24, 0x7f); MT_WR(0x20, 1);
+	MT_WR(0x258, 0); MT_WR(0x7c, mt_clock_sel); MT_WR(0x48, (2u << 4) | 1);
+	MT_WR(0x224, 0); MT_WR(0x22c, 0); MT_WR(0x230, 0);
+	MT_WR(0x24c, 0); MT_WR(0x250, 0); MT_WR(0x25c, 0);
+	MT_WR(0x268, 4); /* GENI word length = 8 - 4 */
+	MT_WR(0x278, 0);
+	/* Four little-endian bytes/FIFO word, each shifted MSB first on the wire. */
+	MT_WR(0x260, 0x7f8fe); MT_WR(0x264, 0xffefe);
+	MT_WR(0x284, 0x7f8fe); MT_WR(0x288, 0xffefe);
+	MT_WR(0x254, 0); MT_WR(0x80c, 0); MT_WR(0x810, 0);
+	MT_WR(0x814, ((rx >> 16) & 0x3f) - 1);
+	return MT_RD(0x258) == 0 && MT_RD(0x268) == 4 &&
+	    MT_RD(0x260) == 0x7f8fe && MT_RD(0x264) == 0xffefe;
+}
+static bool
+mt_spi_transfer(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	unsigned sent = 0, received = 0;
+	if (mt_dead || !n || n > MT_WIRE_SIZE || (MT_RD(0x40) & 0x1001) ||
+	    MT_RD(0x800) || MT_RD(0x804)) return false;
+	MT_WR(0x618, 0xffffffffu);
+	MT_WR(0x26c, n); MT_WR(0x270, n);
+	MT_WR(0x600, 3u << 27); /* no fragmentation: CS released at command end */
+	for (unsigned tries = 0; tries < 4000; tries++) {
+		uint32_t irq = MT_RD(0x610), rs = MT_RD(0x804), ts = MT_RD(0x800);
+		if ((irq & 0x3300003e) || irq == 0xffffffffu ||
+		    (rs & 0x1ffffff) > 63 || ts > mt_fifo_depth) break;
+		unsigned words = rs & 0x1ffffff;
+		for (unsigned w = 0; w < words; w++) {
+			uint32_t v = MT_RD(0x780);
+			unsigned valid = 4;
+			if (w + 1 == words && (rs & 0x80000000u) && ((rs >> 28) & 7))
+				valid = (rs >> 28) & 7;
+			if (valid > 4 || valid > n - received) goto failed;
+			for (unsigned j = 0; j < valid; j++) rx[received++] = (uint8_t)(v >> (j * 8));
+		}
+		for (unsigned w = ts; w < mt_fifo_depth && sent < n; w++) {
+			uint32_t v = 0;
+			for (unsigned j = 0; j < 4 && sent < n; j++) v |= (uint32_t)tx[sent++] << (j * 8);
+			MT_WR(0x700, v);
+		}
+		if (irq & 1) {
+			if (sent != n || received != n || (MT_RD(0x40) & 1)) goto failed;
+			MT_WR(0x618, irq);
+			MT_DELAY(150); /* FocalTech minimum CS-high spacing */
+			return true;
+		}
+		MT_WR(0x618, irq & 0x4c000000u);
+		MT_DELAY(5);
+	}
+failed:
+	mt_dead = true;
+	MT_WR(0x604, 2); /* abort only our in-flight command; never reset wrapper */
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(MT_RD(0x40) & 1)) break;
+		MT_DELAY(5);
+	}
+	return false;
+}
+#endif
--- /dev/null
+++ b/bsd/dev/metroid_touch_protocol.h
@@ -0,0 +1,69 @@
+/* Metroid FT3683G wire protocol. NothingOSS SM8735 031e8669, focaltech_tp.
+ * No hardware access here: callers commit a complete validated frame only.
+ */
+#ifndef METROID_TOUCH_PROTOCOL_H
+#define METROID_TOUCH_PROTOCOL_H
+#define MT_FINGERS 10
+#define MT_WIDTH 1260
+#define MT_HEIGHT 2800
+#define MT_REPORT_SIZE 84
+#define MT_WIRE_SIZE (MT_REPORT_SIZE + 9)
+struct mt_frame {
+	unsigned mask;
+	int x[MT_FINGERS], y[MT_FINGERS];
+};
+static uint16_t
+mt_crc(const uint8_t *p, unsigned n)
+{
+	uint16_t crc = 0xffff;
+	for (unsigned i = 0; i < n; i++) {
+		crc ^= p[i];
+		for (unsigned j = 0; j < 8; j++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0x8408 : 0);
+	}
+	return crc;
+}
+static bool
+mt_response_valid(const uint8_t *p, unsigned n)
+{
+	return n && n <= MT_REPORT_SIZE && !(p[3] & 0xa0) &&
+	    mt_crc(p + 7, n) == ((unsigned)p[n + 7] | ((unsigned)p[n + 8] << 8));
+}
+/* Return 1 for a contact snapshot, 0 for firmware reset, -1 for bad data.
+ * v0 uses six-byte records and a live-contact count. v2 uses eight-byte
+ * records and an event count, including releases, with 1/16-pixel positions.
+ */
+static int
+mt_decode(const uint8_t *p, unsigned n, struct mt_frame *out)
+{
+	struct mt_frame f = {0};
+	unsigned seen = 0, live = 0, count, type, stride, start, records;
+	if (n != MT_REPORT_SIZE) return -1;
+	if (p[1] == 0xff && p[2] == 0xff && p[3] == 0xff && p[4] == 0xff) return 0;
+	count = p[1] & 15;
+	type = p[1] >> 4;
+	if (count > MT_FINGERS || (type != 0 && type != 2)) return -1;
+	stride = type == 2 ? 8 : 6;
+	start = type == 2 ? 4 : 2;
+	records = type == 2 ? count : MT_FINGERS;
+	for (unsigned i = 0; i < records; i++) {
+		const uint8_t *r = p + start + i * stride;
+		unsigned id = r[2] >> 4, flag = r[0] >> 6;
+		if (id == 15 && type == 0) break;
+		if (id >= MT_FINGERS || flag == 3 || (seen & (1u << id))) return -1;
+		seen |= 1u << id;
+		if (flag == 1) continue;
+		int x = ((r[0] & 15) << 8) | r[1];
+		int y = ((r[2] & 15) << 8) | r[3];
+		/* v2 low fractional nibbles do not change integer pixels (HIRES_EN=0). */
+		if (x > MT_WIDTH || y > MT_HEIGHT) return -1;
+		f.x[id] = x == MT_WIDTH ? MT_WIDTH - 1 : x;
+		f.y[id] = y == MT_HEIGHT ? MT_HEIGHT - 1 : y;
+		f.mask |= 1u << id;
+		live++;
+	}
+	if (type == 0 && live != count) return -1;
+	*out = f;
+	return 1;
+}
+#endif
--- /dev/null
+++ b/bsd/dev/metroid_touch_power.h
@@ -0,0 +1,336 @@
+/* Metroid touch-only RPMh client, adapted from sweet_rpmh.c.
+ * Sole XNU apps-DRV2 owner; deep sleep is not implemented.
+ * Empty ACTIVE slots 3/4 only. Preserve sleep/wake and other DRVs.
+ */
+/* Live Metroid DT: apps_rsc DRV2 and its channel-0 TCS bank. */
+#define RH_RSC_PA       0x17a20000u
+#define RH_TCS_PA       0x17a20d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DB_PA        0x81c60000u
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u
+#define RH_ACTIVE_FIRST 3u /* DT order: WAKE 3, ACTIVE 2, SLEEP 2, FAST 1 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   rh_cmd_stride
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT rh_wait
+#define RH_CONTROL rh_control
+#define RH_STATUS rh_status
+#define RH_ENABLE rh_enable
+#define RH_MSGID rh_msgid
+#define RH_ADDR rh_addr
+#define RH_DATA rh_data
+#define RH_CMD_STATUS rh_cmd_status
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_VRM          4u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_db;
+static unsigned rh_cmd_stride, rh_wait, rh_control, rh_status, rh_enable;
+static unsigned rh_msgid, rh_addr, rh_data, rh_cmd_status;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("METROID TOUCH POWER: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_rsc || !rh_tcs) {
+		printf("METROID TOUCH POWER: RSC mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("METROID TOUCH POWER: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* Layouts from NothingOSS rpmh-rsc.c; DT explicitly uses 0x2a0 spacing. */
+	if ((major != 1 && major != 2 && major != 3) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("METROID TOUCH POWER: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	rh_cmd_stride = major == 3 ? 24 : 20;
+	rh_wait = major == 3 ? 0x20 : 0x10;
+	rh_control = rh_wait + 4; rh_status = rh_wait + 8; rh_enable = rh_wait + 12;
+	rh_msgid = major == 3 ? 0x34 : 0x30;
+	rh_addr = rh_msgid + 4; rh_data = rh_msgid + 8; rh_cmd_status = rh_msgid + 12;
+	if (!rh_db) {
+		rh_db_size = 0x20000; /* live DT reserved command DB */
+		rh_db = ml_io_map(RH_DB_PA, rh_db_size);
+		if (!rh_db) return ENOMEM;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("METROID TOUCH POWER: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("METROID TOUCH POWER: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("METROID TOUCH POWER: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("METROID TOUCH POWER: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("METROID TOUCH POWER: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("METROID TOUCH POWER: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = RH_ACTIVE_FIRST; t < RH_ACTIVE_FIRST + RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("METROID TOUCH POWER: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("METROID TOUCH POWER: conflicting inherited touch rail request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("METROID TOUCH POWER: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("METROID TOUCH POWER: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("METROID TOUCH POWER: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("METROID TOUCH POWER: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("METROID TOUCH POWER: touch rail ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+static int
+metroid_touch_power_enable(const char *res, unsigned mv)
+{
+	/* Live Metroid DT voltages; never accept arbitrary regulator writes. */
+	if (!res || !((!strcmp(res, "ldob22") && mv == 3200) ||
+	    (!strcmp(res, "ldod1") && mv == 1800))) return EINVAL;
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("METROID TOUCH POWER: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("METROID TOUCH POWER: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
