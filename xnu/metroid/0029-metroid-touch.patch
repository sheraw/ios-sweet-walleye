+/* Nothing Phone (3): QUP1 SE4 SPI / FocalTech FT3683G touchscreen.
+ * Board facts from the captured Metroid live DT, protocol/register definitions
+ * checked against NothingOSS SM8735 031e8669. No firmware flashing or DMA.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch_frame(unsigned, const int *, const int *);
+void metroid_touch_init(void);
+
+#include "metroid_touch_protocol.h"
+static vm_offset_t mt_se, mt_gcc, mt_gpio;
+static unsigned mt_started;
+static uint32_t
+mt_read(vm_offset_t base, unsigned off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+static void
+mt_write(vm_offset_t base, unsigned off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+#define MT_RD(off) mt_read(mt_se, (off))
+#define MT_WR(off, value) mt_write(mt_se, (off), (value))
+#define MT_DELAY(us) delay(us)
+#include "metroid_touch_spi.h"
+#include "metroid_touch_power.h"
+
+static void
+mt_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&mt_started, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+static bool
+mt_clear(vm_offset_t base, unsigned off, unsigned mask)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(mt_read(base, off) & mask)) return true;
+		delay(5);
+	}
+	return false;
+}
+static bool
+mt_clocks(void)
+{
+	const unsigned vote = (1u << 20) | (1u << 21) | (1u << 26);
+	uint32_t v = mt_read(mt_gcc, 0x52008);
+	if (v == 0xffffffffu) return false;
+	mt_write(mt_gcc, 0x52008, v | vote);
+	if ((mt_read(mt_gcc, 0x52008) & vote) != vote) return false;
+	if (!mt_clear(mt_gcc, 0x23000, 1u << 31) ||
+	    !mt_clear(mt_gcc, 0x23004, 1u << 31) || (MT_RD(0x40) & 0x1001)) return false;
+
+	uint32_t dfs = mt_read(mt_gcc, 0x183f0);
+	if (dfs & 1) {
+		/* Select an existing XO/1 performance row; keep firmware LUT intact. */
+		bool found = false;
+		for (unsigned row = 0; row < 8; row++) {
+			v = mt_read(mt_gcc, 0x183f8 + row * 4);
+			if ((v & 0x371f) == 1) { mt_clock_sel = row; found = true; break; }
+		}
+		if (!found) {
+			printf("METROID TOUCH: DFS has no XO/1 row; stopped\n");
+			return false;
+		}
+	} else {
+		v = mt_read(mt_gcc, 0x183e0);
+		v = (v & ~(0x371fu | (1u << 20))) | 1;
+		mt_write(mt_gcc, 0x183e0, v);
+		mt_write(mt_gcc, 0x183dc, mt_read(mt_gcc, 0x183dc) | 1);
+		if (!mt_clear(mt_gcc, 0x183dc, 1) ||
+		    (mt_read(mt_gcc, 0x183e0) & 0x371f) != 1) return false;
+	}
+	/* XO/1 = 19.2 MHz; serial divider 2 yields 9.6 MHz, below DT 12 MHz. */
+	return mt_clear(mt_gcc, 0x23000, 1u << 31) &&
+	    mt_clear(mt_gcc, 0x23004, 1u << 31) &&
+	    mt_clear(mt_gcc, 0x183cc, 1u << 31);
+}
+static bool
+mt_pin(unsigned pin, unsigned mux, unsigned drive, bool output, bool high)
+{
+	/* tuna TLMM GPIO registers start at TLMM+0x100000, not the old Redmi tile. */
+	unsigned off = pin * 0x1000;
+	uint32_t cfg = mt_read(mt_gpio, off);
+	if (cfg == 0xffffffffu) return false;
+	/* EGPIO ownership belongs to firmware: don't drive a remotely owned pad. */
+	if ((cfg & (1u << 11)) && !(cfg & (1u << 12))) return false;
+	if (output) mt_write(mt_gpio, off + 4,
+	    (mt_read(mt_gpio, off + 4) & ~2u) | (high ? 2u : 0));
+	cfg = (cfg & ~0x3ffu) | (mux << 2) | (drive << 6) | (output ? 0x200 : 0);
+	mt_write(mt_gpio, off, cfg);
+	return (mt_read(mt_gpio, off) & 0x3ff) == (cfg & 0x3ff);
+}
+static bool
+mt_read_register(uint8_t reg, uint8_t *data, unsigned n)
+{
+	uint8_t tx[MT_WIRE_SIZE] = {0}, rx[MT_WIRE_SIZE];
+	if (!n || n > MT_REPORT_SIZE) return false;
+	tx[0] = reg; tx[1] = 0xa0; tx[2] = (uint8_t)(n >> 8); tx[3] = (uint8_t)n;
+	for (unsigned i = 0; i < 3 && !mt_dead; i++) {
+		if (!mt_spi_transfer(tx, rx, n + 9)) return false;
+		if (mt_response_valid(rx, n)) {
+			memcpy(data, rx + 7, n);
+			return true;
+		}
+	}
+	return false;
+}
+static bool
+mt_write_register(uint8_t reg, uint8_t value)
+{
+	uint8_t tx[8] = {reg, 0, 0, 1, 0, 0, 0, value}, rx[8];
+	for (unsigned i = 0; i < 3 && !mt_dead; i++) {
+		if (!mt_spi_transfer(tx, rx, sizeof(tx))) return false;
+		if (!(rx[3] & 0xa0)) return true;
+	}
+	return false;
+}
+static bool
+mt_probe(void)
+{
+	uint8_t hi = 0, lo = 0;
+	for (unsigned i = 0; i < 10 && !mt_dead; i++) {
+		if (mt_read_register(0xa3, &hi, 1) && mt_read_register(0x9f, &lo, 1) &&
+		    hi == 0x56 && lo == 0x72) {
+			printf("METROID TOUCH: FT3683G id=%02x:%02x verified\n", hi, lo);
+			return true;
+		}
+		mt_sleep(100);
+	}
+	printf("METROID TOUCH: unsupported/unresponsive IC id=%02x:%02x dead=%d; stopped\n", hi, lo, mt_dead);
+	return false;
+}
+static void
+mt_thread(void *arg __unused, wait_result_t result __unused)
+{
+	struct mt_frame frame = {0};
+	uint8_t report[MT_REPORT_SIZE];
+	unsigned errors = 0, idle_ticks = 0, frames = 0;
+	unsigned delay_s = 3;
+	(void)PE_parse_boot_argn("metroid_touch_delay", &delay_s, sizeof(delay_s));
+	if (delay_s > 60) delay_s = 60;
+	mt_sleep(delay_s * 1000);
+	mt_gcc = ml_io_map(0x100000, 0x60000);
+	mt_se = ml_io_map(0xa90000, 0x4000);
+	mt_gpio = ml_io_map(0xf100000, 0xc0000);
+	if (!mt_gcc || !mt_se || !mt_gpio) {
+		printf("METROID TOUCH: MMIO mapping failed\n"); goto out;
+	}
+	if (!mt_clocks()) { printf("METROID TOUCH: clock setup failed\n"); goto out; }
+	printf("METROID TOUCH: GENI fw=%#x interface=%#x status=%#x\n", MT_RD(0x68), MT_RD(0x64), MT_RD(0x40));
+	if (!mt_spi_init()) {
+		printf("METROID TOUCH: need idle GENI SPI firmware and FIFO access; stopped\n"); goto out;
+	}
+	/* Rails first; reset pulse only after both acknowledged power votes. */
+	if (metroid_touch_power_enable("ldob22", 3200) ||
+	    metroid_touch_power_enable("ldod1", 1800)) goto out;
+	mt_sleep(10);
+	for (unsigned pin = 16; pin <= 19; pin++) {
+		if (!mt_pin(pin, 1, 2, false, false)) {
+			printf("METROID TOUCH: SPI pin%u setup failed\n", pin); goto out;
+		}
+	}
+	if (!mt_pin(176, 0, 0, false, false) || !mt_pin(189, 0, 0, true, false)) {
+		printf("METROID TOUCH: IRQ/reset GPIO setup failed\n"); goto out;
+	}
+	mt_sleep(2);
+	if (!mt_pin(189, 0, 0, true, true)) goto out;
+	mt_sleep(200);
+	if (!mt_probe()) goto out;
+	/* Normal scan, disable gesture-only reporting. No firmware/config upload. */
+	if (!mt_write_register(0xa5, 0) || !mt_write_register(0xd0, 0)) {
+		printf("METROID TOUCH: normal scan setup failed\n"); goto out;
+	}
+	printf("METROID TOUCH: ready 1260x2800, 10 fingers, SPI 9.6MHz, poll 8ms\n");
+	for (;;) {
+		mt_sleep(8);
+		/* Poll while touching. Idle IRQ is a hint; 104ms watchdog catches lost edges. */
+		if (!frame.mask && (mt_read(mt_gpio, 176 * 0x1000 + 4) & 1) && ++idle_ticks < 13) continue;
+		idle_ticks = 0;
+		struct mt_frame next;
+		int decoded = mt_read_register(1, report, sizeof(report)) ? mt_decode(report, sizeof(report), &next) : -1;
+		if (decoded <= 0) {
+			if (++errors == 1) printf("METROID TOUCH: report rejected kind=%d dead=%d\n", decoded, mt_dead);
+			if (!decoded || errors >= 5 || mt_dead) {
+				frame.mask = 0;
+				sweet_hid_touch_frame(0, frame.x, frame.y);
+			}
+			if (mt_dead || errors >= 50) { printf("METROID TOUCH: persistent transport/report failure; stopped\n"); break; }
+			continue;
+		}
+		errors = 0;
+		frame = next;
+		sweet_hid_touch_frame(frame.mask, frame.x, frame.y);
+		if (frame.mask && frames++ == 0) printf("METROID TOUCH: first validated contact mask=%#x\n", frame.mask);
+	}
+out:
+	sweet_hid_touch_frame(0, frame.x, frame.y);
+	(void)thread_terminate(current_thread());
+}
+void
+metroid_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	(void)PE_parse_boot_argn("metroid_touch", &enabled, sizeof(enabled));
+	if (!enabled) { printf("METROID TOUCH: disabled (metroid_touch=0)\n"); return; }
+	if (__atomic_exchange_n(&mt_started, 1, __ATOMIC_ACQUIRE)) return;
+	kern_return_t kr = kernel_thread_start(mt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) thread_deallocate(thread);
+	else printf("METROID TOUCH: thread start failed %d\n", kr);
+}
