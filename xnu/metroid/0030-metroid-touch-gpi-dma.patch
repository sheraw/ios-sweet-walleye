+/* Per-touch SMMUv2 stage1 domain; preserve all other firmware streams.
+ * arm-smmu/qsmmuv500 and fastmap reference: Nothing031e8669. */
+static bool
+md_smr_matches(struct md_domain *h, uint32_t smr)
+{
+	uint32_t mask = (smr >> 16) & 0x7fff;
+	return (smr & (1u << 31)) && !(((smr & 0xffff) ^ h->sid) & ~mask);
