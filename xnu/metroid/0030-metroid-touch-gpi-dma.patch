+	    !mg_config(ctx, config, event ? 0xff01000fu : 0xff07c00fu) ||
+	    !mg_config(ctx + 4, size, 0xffff) ||
+	    !mg_config(ctx + 8, MG_IOVA + off, UINT32_MAX) ||
+	    !mg_config(ctx + 12, 0, UINT32_MAX)) return false;
+	mg_w(db + 4, 0);
