+#define MD_TABLE_SIZE 0x3000u
+#define MD_IOVA MG_IOVA
+#define MD_ADDR_MASK 0x0000fffffffff000ull
+#define MD_SMMU_FSR_FAULT 0xc00001feu
+#define MD_CLEAN(va,n) MG_CLEAN((void *)(va),(n))
+#define MD_BARRIER() __builtin_arm_dsb(0xf)
