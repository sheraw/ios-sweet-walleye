+				 * Its words are status/timestamp/count, not a DMA pointer.
+				 * Stale records are discarded by the GPI core. Neither
+				 * event may set done, copy RX or bypass the deadline. */
+				if (type == 0x31 && mg.notice_logs < 4) {
