+			MG_FLUSH(mg.pool + MG_RX_DATA, 128);
+			memcpy(rx, mg.pool + MG_RX_DATA, n);
+			MG_DELAY(150); /* FT3683G CS-high spacing */
+			return true;
+		}
+		MG_DELAY(5);
+	} while (MG_NOW() - start < 20000);
