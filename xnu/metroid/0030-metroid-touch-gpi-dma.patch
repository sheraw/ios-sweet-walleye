+	uint32_t size = event ? MG_EVENT_SIZE : MG_RING_SIZE;
+	uint32_t config = (16u << 24) | 2u | (event ? (1u << 16) : (ch ? 0u : 8u));
+	uint32_t db = event ? 0x22100 : 0x22000 + 8 * ch;
