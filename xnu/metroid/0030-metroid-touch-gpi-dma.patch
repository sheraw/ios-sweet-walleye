+			unsigned status = e.d[3] & 0xffff;
+			/* Nothing SPI callbacks reject status == UNEXP_ERR (16),
+			 * not every nonzero peripheral status. In particular the
+			 * observed RX EOT has status 3. Status and completion code
+			 * are separate fields; keep the exact EOT/ownership checks. */
+			if (type != 0x22 || ch > 1 || code != 2 || len != n ||
+			    status == 16 || e.d[1] || e.d[0] != (ch ? expected_rx : expected_tx) ||
+			    (done & (1u << ch))) {
+				MG_LOG("METROID TOUCH GPI: rejected event %08x %08x %08x %08x\n", e.d[0], e.d[1], e.d[2], e.d[3]);
+				MG_LOG("METROID TOUCH GPI: type=%#x ch=%u code=%#x len=%u want=%u status=%#x ptr=%#x:%08x expected-TX=%#x RX=%#x done=%#x\n",
+				    type, ch, code, len, n, e.d[3] & 0xffff, e.d[1], e.d[0], expected_tx, expected_rx, done);
+				return mg_stop(type == 0x30 ? "unexpected immediate-data event for buffer DMA" :
+				    ((type == 0x35 || type == 0x36) ? "unexpected Q2SPI event for SPI" : "bad/stale completion"));
+			}
+			if (status && mg.status_logs < 4) {
+				mg.status_logs++;
+				MG_LOG("METROID TOUCH GPI: EOT ch=%u status=%#x len=%u; vendor SPI status policy\n",
+				    ch, status, len);
+			}
+			done |= 1u << ch;
+			mg.ev_rp = mg_next(mg.ev_rp, MG_EVENT_SIZE);
+			mg_w(0x22100, MG_IOVA + MG_EV + ((mg.ev_rp + MG_EVENT_SIZE - 16) & (MG_EVENT_SIZE - 1)));
+		}
+		mg_w(0x230c0, 1);
+		if (done == 3 && mg_r(0x20010) == MG_IOVA + MG_TX + tw &&
+		    mg_r(0x20090) == MG_IOVA + MG_RX + rw && !mg_r(0x20014) && !mg_r(0x20094)) {
+			/* Do not publish RX if a fault arrived with the completions. */
+			if (mg_error() || mg_state(0x20000) != 2 || mg_state(0x20080) != 2)
+				return mg_stop("DMA fault/channel error at completion");
