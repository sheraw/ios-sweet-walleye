+		mg_w(ctx + 0x20, 0); mg_w(ctx + 0x28, 0); mg_w(ctx + 0x2c, 0);
+		mg_w(ctx + 0x30, 0); mg_w(ctx + 0x34, 0);
+		mg_w(db, MG_IOVA + MG_EV + MG_EVENT_SIZE - 16);
