+/* Polled QUP1 GPI SPI. Register/TRE reference: NothingOSS 031e8669,
+ * msm_gpi{,_mmio.h}, msm_gpi.h, spi-msm-geni.c. No GSI firmware upload.
+ * Only app dynamic GPIIs 1..4; static GPII0 and other EEs are never reset.
+ * MG_{READ,WRITE,CLEAN,FLUSH,NOW,DELAY} and MG_DMA_INIT supplied by caller.
+ */
+#ifndef METROID_TOUCH_GPI_H
+#define METROID_TOUCH_GPI_H
+/* Nothing DT: max-num-gpii=12 is capacity, not an access mask.
+ * Apps dynamic1..4, static0; contexts5..11 are never accessed. */
+#define MG_APP_DYNAMIC_MASK 0x1eu
+#define MG_APP_STATIC_MASK 0x1u
+#define MG_APP_ACCESS_MASK (MG_APP_DYNAMIC_MASK | MG_APP_STATIC_MASK)
+#define MG_RING_SIZE 1024u
+#define MG_EVENT_SIZE 2048u
+#define MG_POOL_SIZE 0x4000u
+#define MG_IOVA 0x200000u
+#define MG_TX 0u
+#define MG_RX 0x400u
+#define MG_EV 0x800u
+#define MG_TX_DATA 0x1000u
+#define MG_RX_DATA 0x1100u
+struct mg_tre { uint32_t d[4]; };
+struct mg_host {
+	uint8_t *pool;
+	uint32_t instance, tx_wp, rx_wp, ev_rp;
+	unsigned notice_logs, status_logs;
+	bool owned, dead, ready;
+};
+static struct mg_host mg;
+static uint32_t mg_off(uint32_t off) { return off + mg.instance * 0x4000; }
+static uint32_t mg_r(uint32_t off) { return MG_READ(mg_off(off)); }
+static void mg_w(uint32_t off, uint32_t val) { MG_WRITE(mg_off(off), val); }
+static uint32_t mg_state(uint32_t off) { return (mg_r(off) >> 20) & 15; }
+static bool
+mg_error(void)
+{
+	return mg_r(0x23100) != 0 || mg_r(0x23118) != 0 || MG_DMA_FAULT();
+}
+static bool
+mg_stop(const char *why)
+{
+	mg.dead = true; mg.ready = false;
+	MG_LOG("METROID TOUCH GPI: %s; quarantined GPII%u ch=%#x/%#x ev=%#x global=%#x general=%#x error=%#x\n",
+	    why, mg.instance, mg_r(0x20000), mg_r(0x20080), mg_r(0x21000),
+	    mg_r(0x23100), mg_r(0x23118), mg_r(0x23200));
+	/* No reset, unmap, free or retry after uncertain DMA. Pinned pages and
+	 * translations remain valid until reboot. Mask only our GPII IRQ output. */
+	if (mg.owned) {
+		mg_w(0x23088, 0);
+
+	}
+	return false;
+}
+static bool
+mg_command(bool event, unsigned ch, unsigned op, unsigned state)
+{
+	uint32_t src = event ? 0x23094 : 0x23090;
+	uint32_t clr = event ? 0x230a4 : 0x230a0;
+	uint32_t bit = 1u << ch, ctx = event ? 0x21000 : 0x20000 + 0x80 * ch;
+	mg_w(clr, bit);
+	if (mg_r(src) & bit) return mg_stop("stale command completion");
+	mg_w(event ? 0x23010 : 0x23008, (op << 24) | ch);
+	uint64_t start = MG_NOW();
+	do {
+		if (mg_error()) return mg_stop("command hardware error");
+		if ((mg_r(src) & bit) && mg_state(ctx) == state) {
+			mg_w(clr, bit);
+			return true;
+		}
+		MG_DELAY(5);
+	} while (MG_NOW() - start < 250000);
+	MG_LOG("METROID TOUCH GPI: command event=%u ch=%u op=%u expected-state=%u\n", event, ch, op, state);
+	return mg_stop("command timeout/state mismatch");
+}
+static bool
+mg_quiesce(void)
+{
+	unsigned inherited = 12;
+	/* Reclaim only an app pair explicitly identifying this touchscreen.
+	 * Audit only DT-authorized apps contexts before changing that pair. */
+	for (unsigned i = 0; i < 12; i++) {
+		if (!(MG_APP_ACCESS_MASK & (1u << i))) continue;
+		mg.instance = i;
+		MG_LOG("METROID TOUCH GPI: inspect GPII%u\n", i);
+		uint32_t a = mg_r(0x20000), b = mg_r(0x20080), e = mg_r(0x21000);
+		if (a == UINT32_MAX || b == UINT32_MAX || e == UINT32_MAX) return false;
+		if (!((a | b | e) & 0xf00000u)) continue;
+		uint32_t sa = mg_r(0x20060), sb = mg_r(0x200e0);
+		if (!(MG_APP_DYNAMIC_MASK & (1u << i)) || inherited != 12 ||
+		    (sa & 0x1f80ff) != 0x10014 || (sb & 0x1f80ff) != 0x14 ||
+		    mg_state(0x20000) > 3 || mg_state(0x20080) > 3 || mg_state(0x21000) != 1) {
+			MG_LOG("METROID TOUCH GPI: inherited GPII%u not an owned SE4 SPI pair; stopped\n", i);
+			return false;
+		}
+		inherited = i;
+	}
+	if (inherited == 12) return true;
+	mg.instance = inherited; mg.owned = true;
+	mg_w(0x23088, 0);
+	mg_w(0x23098, 3); mg_w(0x2309c, 1);
+	/* The old domains remain attached until stop/reset/deallocate completes.
+	 * No other GPII, EE, firmware image or global GSI state is reset. */
+	for (unsigned ch = 0; ch < 2; ch++) {
+		unsigned state = mg_state(0x20000 + 0x80 * ch);
+		if (!state) continue;
+		if (state == 2 && !mg_command(false, ch, 2, 3)) return false;
+		if (!mg_command(false, ch, 9, 1) || !mg_command(false, ch, 10, 0)) return false;
+	}
+	if (!mg_command(true, 0, 10, 0)) return false;
+	MG_LOG("METROID TOUCH GPI: quiesced inherited SE4 SPI GPII%u\n", inherited);
+	mg.owned = false;
+	return true;
+}
+static bool
+mg_select(void)
+{
+	unsigned candidate = 12;
+	/* Only inspect apps-owned rings. This cannot prove wrapper-wide idle;
+	 * DMA setup separately refuses to replace inherited live translations. */
+	for (unsigned i = 0; i < 12; i++) {
+		if (!(MG_APP_ACCESS_MASK & (1u << i))) continue;
+		mg.instance = i;
+		uint32_t a = mg_r(0x20000), b = mg_r(0x20080), e = mg_r(0x21000);
+		if (a == UINT32_MAX || b == UINT32_MAX || e == UINT32_MAX) {
+			MG_LOG("METROID TOUCH GPI: unreadable GPII%u; cannot establish stream ownership\n", i);
+			return false;
+		}
+		if (((a | b | e) & 0xf00000u) != 0) {
+			MG_LOG("METROID TOUCH GPI: inherited GPII%u ch=%#x/%#x ev=%#x; shared DMA stream busy\n", i, a, b, e);
+			return false;
+		}
+		if ((MG_APP_DYNAMIC_MASK & (1u << i)) && candidate == 12) candidate = i;
+	}
+	mg.instance = candidate;
+	return candidate < 12;
+}
