+static uint32_t md_sr(struct md_domain *h, uint32_t off) { return mt_read(h->smmu,off); }
+static void md_sw(struct md_domain *h, uint32_t off,uint32_t v) { mt_write(h->smmu,off,v); }
+static uint32_t md_cb(struct md_domain *h,uint32_t cb) { return h->cb_base+(cb<<h->pgshift); }
+static uint64_t md_sr64(struct md_domain *h,uint32_t off) { return (uint64_t)md_sr(h,off)|((uint64_t)md_sr(h,off+4)<<32); }
+static void md_sw64(struct md_domain *h,uint32_t off,uint64_t v) {
+    *(volatile uint64_t *)(h->smmu+off)=v; MD_BARRIER();
+}
+static int md_poll(struct md_domain *h,bool unused,uint32_t off,uint32_t mask,uint32_t want,unsigned us) {
+    (void)unused; uint64_t start=mt_now_us();
+    do { if ((md_sr(h,off)&mask)==want) return 0; delay(5); } while(mt_now_us()-start<us);
