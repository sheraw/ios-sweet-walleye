+	md_sw(h, h->gr1 + 4 * h->cb, cbar);
+	md_sw(h, b + 0x10, tcr2);
+	md_sw(h, b + 0x30, tcr);
+	md_sw64(h, b + 0x20, ttbr);
+	md_sw64(h, b + 0x28, 0);
+	md_sw(h, b + 0x38, 0xff); /* MAIR0 Attr0: Normal WB */
+	md_sw(h, b + 0x3c, 0);
+	md_sw(h, b + 0x58, md_sr(h, b + 0x58) & MD_SMMU_FSR_FAULT);
+	if ((error = md_check32(h, h->gr1 + 0x800 + 4 * h->cb, 1, 1, "CBA2R VA64")) ||
+	    (error = md_check32(h, h->gr1 + 4 * h->cb, cbar, 3u << 16, "CBAR stage")) ||
+	    (error = md_check32(h, b + 0x10, tcr2, 0xf, "TCR2 PA size")) ||
+	    (error = md_check32(h, b + 0x30, tcr, (1u << 23) | (1u << 22) | (3u << 14) | (1u << 7) | 0x3f, "TCR format")) ||
+	    (error = md_check_ttbr(h, b + 0x20, ttbr)) ||
+	    (error = md_check32(h, b + 0x38, 0xff, 0xff, "MAIR Attr0"))) { goto fail; }
+	if (md_tlb_sync(h, h->asid)) { error = ETIMEDOUT; goto fail; }
+	/* Abort on faults rather than stall forever; poll FSR instead of using IRQ. */
+	uint32_t sctlr = (1u << 12) | (1u << 5) | (1u << 2) | (1u << 1) | 1;
+	md_sw(h, b, sctlr);
+	if ((error = md_check32(h, b, sctlr, 1, "SCTLR enable"))) { goto fail; }
+	/* Linux uses TRANS + PRIVCFG_DEFAULT when attaching a DMA domain. */
+	uint32_t s2cr = h->cb;
+	md_sw(h, 0xc00 + 4 * h->smr, s2cr);
+	if ((error = md_check32(h, 0xc00 + 4 * h->smr, s2cr, (3u << 16) | 0xff, "S2CR route"))) { goto fail; }
+	md_sw(h, 0x800 + 4 * h->smr, (1u << 31) | h->sid);
+	if ((error = md_check32(h, 0x800 + 4 * h->smr, (1u << 31) | h->sid, UINT32_MAX, "SMR match"))) { goto fail; }
+	h->mapped = true;
+	MD_LOG("METROID TOUCH DMA: stream SMR=%u CB=%u ASID=%u IOVA=%llx PA=%llx bytes=%x TTBR=%llx (NC table walks, explicit cache sync)\n",
+	    h->smr, h->cb, h->asid, (unsigned long long)MD_IOVA,
+	    (unsigned long long)h->pool_pa, MD_POOL_SIZE, (unsigned long long)h->tables_pa);
+	return 0;
+fail:
+	md_sw(h, b, 0);
+	h->failed = true;
+	return error;
+}
