+static int
+md_choose_context(struct md_domain *h)
+{
+	uint32_t id0 = md_sr(h, 0x20), id1 = md_sr(h, 0x24), id2 = md_sr(h, 0x28);
+	uint32_t scr0 = md_sr(h, 0);
