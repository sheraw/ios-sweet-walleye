+/* USB2 CDC-ECM control and DMA completion bounds; no hardware accesses. */
+#ifndef METROID_USB_PROTOCOL_H
+#define METROID_USB_PROTOCOL_H
+static inline bool mu_setup_supported(const uint8_t *p)
+{
+ unsigned type=p[0], request=p[1], value=p[2]|((unsigned)p[3]<<8);
+ unsigned index=p[4]|((unsigned)p[5]<<8), length=p[6]|((unsigned)p[7]<<8);
+ if ((type&0x60)==0x20)
+  return type==0x21 && request==0x43 && !index && !length && value<=0x1f;
+ if (type&0x60) return false;
+ switch (request) {
+ case 6: return type==0x80 && (value>>8)>=1 && (value>>8)<=3;
+ case 5: return !type && value<128 && !index && !length;
+ case 9: return !type && value<=1 && !index && !length;
+ case 8: return type==0x80 && !value && !index && length==1;
+ case 0: return (type==0x80 || type==0x81 || type==0x82) && !value && length==2;
+ case 11: return type==1 && index<=1 && value<=(index?1u:0u) && !length;
+ case 10: return type==0x81 && !value && index<=1 && length==1;
+ default: return false;
+ }
+}
+static inline bool mu_rx_length(uint32_t size, uint32_t control, uint32_t capacity, uint32_t *length)
+{
+ if (!length || (control&1) || (size>>28) || (size&0xffffff)>capacity) return false;
+ *length=capacity-(size&0xffffff); return true;
+}
+static inline bool mu_event_count(uint32_t count, uint32_t capacity)
+{ return !(count&3) && count<=capacity; }
+#endif
