+    bool controller_started = false, interface_started = false, stack_started = false;
+    if (!controller || !interface || !stack || !defaults || !address) goto fail;
+    if (!controller->init() || !interface->init() || !stack->init()) goto fail;
+    controller->setName("MetroidUSBEthernetController");
+    interface->setName("en0");
+    stack->setName("IONetworkStack");
+    if (!controller->setProperty("SelfNamed", kOSBooleanTrue) ||
+        !controller->setProperty("IOMACAddress", address) ||
+        !controller->setProperty("IOFeatures", 0ULL, 32) ||
+        !controller->setProperty("IOLinkStatus", 1ULL, 32) ||
+        !controller->setProperty("IOLinkSpeed", 0ULL, 64) ||
+        !controller->setProperty("MetroidDiscoveryBridge", kOSBooleanTrue) ||
+        !interface->setProperty("IOBSDName", "en0") ||
+        !interface->setProperty("IOInterfaceNamePrefix", "en") ||
+        !interface->setProperty("IOInterfaceUnit", 0ULL, 32) ||
+        !interface->setProperty("IOInterfaceType", 6ULL, 32) || /* IFT_ETHER */
+        !interface->setProperty("IOInterfaceState", 1ULL, 32) || /* registered */
+        !interface->setProperty("IOBuiltin", kOSBooleanFalse) ||
+        !interface->setProperty("IOPrimaryInterface", kOSBooleanFalse) ||
+        !interface->setProperty("NetworkConfigurationOverrides", defaults)) goto fail;
+    if (!(controller_attached = controller->attach(resources))) goto fail;
+    if (!(controller_started = controller->start(resources))) goto fail;
+    if (!(interface_attached = interface->attach(controller))) goto fail;
+    if (!(interface_started = interface->start(controller))) goto fail;
+    if (!(stack_attached = stack->attach(resources))) goto fail;
+    if (!(stack_started = stack->start(resources))) goto fail;
+    usb_controller = controller;
+    usb_interface = interface;
+    network_stack = stack;
+    defaults->release();
+    address->release();
+    /* Publish only once the complete hierarchy/properties are available. */
+    controller->registerService();
+    interface->registerService();
+    stack->registerService();
+    IOLog("METROID USB IOKIT: en0 IOEthernetInterface + IONetworkStack published; native configd adoption unverified\n");
+    return;
+fail:
+    if (stack_started) stack->stop(resources);
+    if (stack_attached) stack->detach(resources);
+    if (interface_started) interface->stop(controller);
+    if (interface_attached) interface->detach(controller);
+    if (controller_started) controller->stop(resources);
+    if (controller_attached) controller->detach(resources);
+    if (stack) stack->release();
+    if (interface) interface->release();
+    if (controller) controller->release();
+    if (defaults) defaults->release();
+    if (address) address->release();
+    IOLog("METROID USB IOKIT: publication failed; BSD Ethernet remains available\n");
+}
+
+extern "C" void metroid_usb_iokit_link(bool up)
+{
+    if (!usb_controller) return;
+    usb_controller->setProperty("IOLinkStatus", up ? 3ULL : 1ULL, 32);
+    usb_controller->setProperty("IOLinkSpeed", up ? 480000000ULL : 0ULL, 64);
+    /* configd receives the real KEV_DL_LINK_ON/OFF posted by the BSD driver. */
+}
+#endif
