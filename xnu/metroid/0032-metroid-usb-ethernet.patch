+/* Retained for the boot lifetime, like the underlying non-detachable ifnet.
+ * The driver's one USB polling thread is the only writer after publication. */
+static IOService *usb_controller;
+static IOEthernetInterface *usb_interface;
+static IONetworkStack *network_stack;
+
+/* Defaults for native SCNetworkService creation; Settings can override them.
+ * Unlike the old helper this never writes configd's dynamic store. */
+static OSDictionary *network_defaults(void)
+{
+    static const char xml[] =
+        "<dict><key>IPv4</key><dict>"
+        "<key>ConfigMethod</key><string>Manual</string>"
+        "<key>Addresses</key><array><string>192.168.7.2</string></array>"
+        "<key>SubnetMasks</key><array><string>255.255.255.0</string></array>"
+        "<key>Router</key><string>192.168.7.1</string>"
+        "</dict><key>DNS</key><dict>"
+        "<key>ServerAddresses</key><array><string>1.1.1.1</string><string>8.8.8.8</string></array>"
+        "</dict></dict>";
+    OSObject *object = OSUnserializeXML(xml);
+    auto result = OSDynamicCast(OSDictionary, object);
+    if (!result && object) object->release();
+    return result;
+}
