+/*
+ * IOKit discovery bridge for the already-attached Metroid BSD Ethernet ifnet.
+ * This is NOT Apple's IONetworkingFamily ABI or a second packet driver.
+ * These minimal class names implement the discovery contract consumed by
+ * configd-1241.140.6 SCNetworkInterface.c and Plugins/InterfaceNamer/ifnamer.c.
+ * Do not load IONetworkingFamily alongside this built-in implementation.
+ *
+ * InterfaceNamer requires an openable IONetworkStack even for SelfNamed
+ * interfaces. Its naming commands are never needed for our fixed en0; all
+ * user-client methods/property writes are explicitly unsupported. Packet I/O,
+ * addressing, flags, multicast and media continue through the real BSD ifnet.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <pexpert/pexpert.h>
+
+class IONetworkInterface : public IOService {
+    OSDeclareDefaultStructors(IONetworkInterface);
+public:
+    IOReturn setProperties(OSObject *) APPLE_KEXT_OVERRIDE { return kIOReturnUnsupported; }
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+    OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class IONetworkStackUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(IONetworkStackUserClient);
+public:
+    IOReturn clientClose(void) APPLE_KEXT_OVERRIDE {
+        terminate();
+        return kIOReturnSuccess;
+    }
+    IOReturn setProperties(OSObject *) APPLE_KEXT_OVERRIDE { return kIOReturnUnsupported; }
+    IOReturn externalMethod(uint32_t, IOExternalMethodArguments *,
+        IOExternalMethodDispatch *, OSObject *, void *) APPLE_KEXT_OVERRIDE {
+        return kIOReturnUnsupported;
+    }
+};
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+class IONetworkStack : public IOService {
+    OSDeclareDefaultStructors(IONetworkStack);
+public:
+    IOReturn setProperties(OSObject *) APPLE_KEXT_OVERRIDE { return kIOReturnUnsupported; }
+    IOReturn newUserClient(task_t task, void *security, UInt32 type,
+        OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+IOReturn IONetworkStack::newUserClient(task_t task, void *security, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+    if (!handler) return kIOReturnBadArgument;
+    *handler = nullptr;
+    if (type != 0) return kIOReturnUnsupported;
+    if (IOUserClient::clientHasPrivilege(task, kIOClientPrivilegeAdministrator)
+        != kIOReturnSuccess) return kIOReturnNotPrivileged;
+    auto client = new IONetworkStackUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(task, security, type, properties)) {
+        client->release();
+        return kIOReturnNoMemory;
+    }
+    if (!client->attach(this)) {
+        client->release();
+        return kIOReturnError;
+    }
+    if (!client->start(this)) {
+        client->detach(this);
+        client->release();
+        return kIOReturnError;
+    }
+    *handler = client;
+    IOLog("METROID USB IOKIT: IONetworkStack connection opened\n");
+    return kIOReturnSuccess;
+}
