+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("METROID USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud_rx_arm();
+	printf("METROID USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+	if (!mu_setup_supported(st)) { ud_stall(); return; }
+
+	printf("METROID USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("METROID USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (!value && ud.configured) { ud.dead = true; return; }
+		if (value == 1) {
+			ud_configure();
+		}
+		printf("METROID USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured && ud.data_alt == 1 && !ud.dead) {
+				ud_notify_connected();
+				ud_link_event(true);
+			} else { ud_link_event(false); }
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 || req == 3) { /* CLEAR/SET_FEATURE (halt, remote wakeup) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+static void
+ud_rx_arm(void)
+{
+	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len;
+	if (!mu_rx_length(t[2], t[3], UD_FRAME_MAX, &len)) { ud.dead = true; return; }
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = len;
+			ud.rx_frames++;
+			ifnet_input(ud.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	ud_rx_arm();
+}
+
+/* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_tx_kick_locked(void)
+{
+	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured && ud.data_alt == 1 && !ud.dead) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		mbuf_freem(m);
+		/* A frame of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one pad byte does the same (IP ignores it). */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+	}
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	size_t length = mbuf_pkthdr_len(m);
+	if (length < ETHER_HDR_LEN || length > ETHER_MAX_LEN - ETHER_CRC_LEN ||
+	    ud.dead || ud.txq_count == UD_TXQ || !ud.configured || ud.data_alt != 1) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return 0;
+}
+
+/*
+ * Link state for configd (KernelEventMonitor reads SIOCGIFMEDIA and the
+ * KEV_DL_LINK_ON/OFF events; IPMonitor does not route through a service
+ * whose interface has no active link).
+ */
+static void
+ud_link_event(bool up)
+{
+	if (ud.ifp != NULL) {
+		ifnet_set_flags(ud.ifp, up ? IFF_RUNNING : 0, IFF_RUNNING);
+		metroid_usb_iokit_link(up);
+		dlil_post_msg(ud.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFDEVMTU: {
+		struct ifreq *ifr = (struct ifreq *)data;
+		ifr->ifr_devmtu.ifdm_current = (int)ifnet_mtu(ifp);
+		ifr->ifr_devmtu.ifdm_min = 68;
+		ifr->ifr_devmtu.ifdm_max = ETHERMTU;
+		return 0;
+	}
+	case SIOCSIFMTU: {
+		int mtu = ((struct ifreq *)data)->ifr_mtu;
+		if (mtu < 68 || mtu > ETHERMTU) return EINVAL;
+		return ifnet_set_mtu(ifp, (uint32_t)mtu);
+	}
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = (ud.configured && ud.data_alt == 1 && !ud.dead) ? (IFM_ETHER | IFM_100_TX | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | ((ud.configured && ud.data_alt == 1 && !ud.dead) ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+ud_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
+static void
+ud_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	static lck_grp_t *grp;
+
+	grp = lck_grp_alloc_init("metroid_usb", LCK_GRP_ATTR_NULL);
+	if (!grp) return;
+	ud.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+	if (!ud.lock) return;
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "metroid-usb-ecm";
+	init.uniqueid_len = sizeof("metroid-usb-ecm") - 1;
+	init.name = "en";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ud_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ud_if_ioctl;
+	init.detach = ud_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ud.ifp) != 0) {
+		printf("METROID USB: ifnet_allocate failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ud.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ud.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ud.ifp, ETHERMTU);
+	ifnet_set_baudrate(ud.ifp, 480000000);
+	ifnet_set_flags(ud.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ud.ifp, NULL) != 0) {
+		printf("METROID USB: ifnet_attach failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ud.ifp, ud_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ud.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "en0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ud.ifp, IFF_UP, IFF_UP | IFF_RUNNING);
+	printf("METROID USB: en0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+	if (err) ud.dead = true;
+	else metroid_usb_iokit_publish(ud_phone_mac);
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+			if (ud.configured) { ud.dead = true; return; }
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			printf("METROID USB: bus reset\n");
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("METROID USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			printf("METROID USB: disconnect\n");
+			if (ud.configured) ud.dead = true;
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (ep == EP_RX && type == 1) {
+		ud_rx_done();
+		return;
+	}
+	if (ep == EP_TX && type == 1) {
+		lck_mtx_lock(ud.lock);
+		ud_sync(UD_TRB_TX, 16);
+		volatile uint32_t *trb = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+		if (!ud.tx_busy || (trb[3] & TRB_HWO) || trb[2]) ud.dead = true;
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ticks = 0;
+	for (;;) {
+  if (ud.dead || usb_dma_fault()) {
+   ud.dead = true; dwc_wr(DEVTEN, 0); dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+   ud_link_event(false); printf("METROID USB: quarantined; DMA memory pinned until reboot\n");
+   (void)thread_terminate(current_thread()); return;
+  }
+  uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+  if (!mu_event_count(count, UD_EVT_SIZE)) { ud.dead = true; continue; }
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 200) {
+					printf("METROID USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+				if (ud.dead) break;
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		if ((++ticks % 30000) == 0) {
+			printf("METROID USB: en0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+		}
+		ud_sleep_ms(1);
+	}
+}
+
+static void
+metroid_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	/* Require the bootloader's gadget fully halted before touching DMA routes. */
+ if (!(dwc_rd(DSTS) & DSTS_DEVCTRLHLT) || (dwc_rd(DCTL) & DCTL_RUN_STOP) ||
+     ((dwc_rd(GCTL) >> 12) & 3) != 2) {
+  printf("METROID USB: need halted inherited device mode; preserving controller\n"); return;
+ }
+
+	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("METROID USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+ if (!usb_dma_init()) return;
+ ud_if_create();
+ if (!ud.ifp || !ud.lock || ud.dead) return;
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_bus + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_bus + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done */
+	dwc_wr(DEVTEN, 0x7);
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("METROID USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+	if (ud.dead) return;
+
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL);
+  /* Vendor dwc3-msm-core.c: UTMI VBUS valid; inherit mux selection.
+   * This USB2-only port does not assert SuperSpeed lane power. */
+  usb_wr(qs, QSCRATCH_HS_PHY_CTRL, hs | UTMI_OTG_VBUS_VALID);
+
+	}
+
+	if (ud.dead || usb_dma_fault()) return;
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	if (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) {
+		ud.dead = true;
+		dwc_wr(DEVTEN, 0);
+		dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+		printf("METROID USB: RUN_STOP failed; controller halted\n");
+		return;
+	}
+	printf("METROID USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_bus);
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		ud.dead = true;
+		dwc_wr(DEVTEN, 0);
+		dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	}
+
+}
+
+static bool
+usb_dma_init(void)
+{
+	if (!(dwc_rd(DSTS) & DSTS_DEVCTRLHLT) || (dwc_rd(DCTL) & (DCTL_RUN_STOP | DCTL_CSFTRST))) return false;
+	vm_offset_t memory = 0;
+	if (kmem_alloc_contig(kernel_map, &memory, 0x8000, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) return false;
+	ppnum_t first = pmap_find_phys(kernel_pmap, memory);
+	ppnum_t last = pmap_find_phys(kernel_pmap, memory + 0x4000);
+	if (!first || ptoa_64(last) != ptoa_64(first) + 0x4000) return false;
+	ud.dma = memory;
+	usb_domain.pool = (uint8_t *)memory;
+	usb_domain.pool_pa = ptoa_64(first);
+	usb_domain.tables = (uint64_t *)(memory + 0x4000);
+	usb_domain.tables_pa = ptoa_64(first) + 0x4000;
+	usb_domain.sid = 0x40;
+	usb_domain.smmu = ml_io_map(0x15000000, 0x100000);
+	usb_domain.controller_halted = true;
+	if (!usb_domain.smmu) return false;
+	metroid_smmu_lock();
+	int error = mu_map_dma(&usb_domain);
+	metroid_smmu_unlock();
+	if (error) { printf("METROID USB: isolated DMA setup failed %d; stopped\n", error); return false; }
+	ud.dma_bus = MU_IOVA;
+	CleanPoC_DcacheRegion_Force(memory, UD_SIZE);
+	return true;
+}
+
+static bool
+usb_dma_fault(void)
+{
+	struct mu_domain *h = &usb_domain;
+	if (!h->mapped || h->failed) return true;
+	uint32_t fsr = mu_sr(h, mu_cb(h, h->cb) + 0x58);
+	if ((fsr & MU_SMMU_FSR_FAULT) ||
+	    mu_sr(h, 0x800 + 4 * h->smr) != (0x80000000u | h->sid) ||
+	    (mu_sr(h, 0xc00 + 4 * h->smr) & 0x300ffu) != h->cb) {
+		printf("METROID USB: DMA route/fault FSR=%#x; quarantined\n", fsr);
+		h->failed = true; return true;
+	}
+	return false;
+}
+
+/* Clock offsets from pinned gcc-tuna.c, domain from captured tuna-gdsc DT.
+ * Reuse ABL's initialized PHY/repeater; never read a gated controller/PHY.
+ */
+static void
+usb_probe(unsigned mode)
+{
+	static const uint32_t clocks[] = {0x39018, 0x39090, 0x39094, 0x3902c, 0x39028};
+	vm_offset_t gcc = ml_io_map(0x100000, 0xa0000);
+	if (!gcc) return;
+	uint32_t power = usb_rd(gcc, 0x39004);
+	bool running = power != UINT32_MAX && (power & (1u << 31));
+	printf("METROID USB: GDSC=%#x\n", power);
+	for (unsigned i = 0; i < sizeof(clocks)/sizeof(clocks[0]); i++) {
+		uint32_t value = usb_rd(gcc, clocks[i]);
+		printf("METROID USB: CBCR[%#x]=%#x\n", clocks[i], value);
+		if (value == UINT32_MAX || (value & (1u << 31))) running = false;
+	}
+	if (!running) { printf("METROID USB: need inherited USB power/clocks; no controller access\n"); return; }
+	vm_offset_t core = ml_io_map(0xa600000, 0x10000);
+	if (!core) return;
+	uint32_t id = usb_rd(core, 0xc120);
+	printf("METROID USB: ID=%#x GCTL=%#x DCTL=%#x DSTS=%#x\n", id,
+	    usb_rd(core, GCTL), usb_rd(core, DCTL), usb_rd(core, DSTS));
+	if ((id >> 16) != 0x5533 && (id >> 16) != 0x3331 && (id >> 16) != 0x3332) return;
+	if (mode == 2) metroid_usb_gadget_start(core);
+}
+
+static void
+usb_start_thread(void *arg, wait_result_t result __unused)
+{
+	usb_probe((unsigned)(uintptr_t)arg);
+	(void)thread_terminate(current_thread());
+}
+void
+metroid_usb_init(void)
+{
+	static unsigned started;
+	unsigned mode = 0;
+	thread_t thread;
+	(void)PE_parse_boot_argn("metroidusb", &mode, sizeof(mode));
+	if ((mode != 1 && mode != 2) || __atomic_exchange_n(&started, 1, __ATOMIC_ACQUIRE)) return;
+	if (kernel_thread_start(usb_start_thread, (void *)(uintptr_t)mode, &thread) == KERN_SUCCESS)
+		thread_deallocate(thread);
+}
